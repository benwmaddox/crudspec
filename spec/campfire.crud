// The Campfire slice (docs/RULE-INVENTORY.md) in crudspec v1 (docs/LANGUAGE.md).
// Rule IDs in comments point to the inventory.

enum Role { member, administrator, bot }                    // P1
enum UserStatus { active, deactivated, banned }
enum RoomType { open, closed, direct }                      // R1
enum Involvement { invisible, nothing, mentions, everything }  // M1

singleton Account {
  join_code: Text
  restrict_room_creation: Bool = false                      // R2
}

entity User {
  name: Text
  email: Text
  email_deactivated: Bool = false
  role: Role = member                                       // P1
  status: UserStatus = active
  unique (email)
}

entity Session {
  user: User on delete cascade
  ip: Ip
  invariant self.user.status == active                      // A3, D3, N1: only active users hold sessions
}

entity Room {
  type: RoomType
  name: Text?
  creator: User                                             // R1
  invariant self.type == direct implies self.name == none   // R5, R11
}

entity Membership {
  room: Room on delete cascade                              // R14
  user: User on delete cascade
  involvement: Involvement = if .room.type == direct { everything } else { mentions }   // R6
  unread: Bool = false
  connected: Bool = false                                   // U2
  unique (room, user)                                       // R7
  // Not an invariant: "a deactivated user keeps only direct-room memberships". D3 removes
  // them, but closed-room creation and revision (R4, R10) can add any user back
  // (scenario oracle/scenarios/checker-findings/f01; found by the checker in v1).
}

entity Message {
  room: Room on delete cascade                              // R14
  creator: User on delete cascade
  body: Text
}

entity Boost {
  message: Message on delete cascade                        // R14, G5
  booster: User on delete cascade
  content: Text                                             // B2: declared 16, not enforced
}

entity Ban {
  user: User on delete cascade
  ip: Ip
  unique (user, ip)                                         // N1: one per distinct address
  invariant self.user.status == banned                      // N1, N3
}

predicate administrator(u: User) = u.role == administrator
predicate can_administer(u: User, creator: User) = u.role == administrator or u == creator   // P2
predicate member(u: User, r: Room) = exists(Membership where .room == r and .user == u)
predicate may_create_rooms(u: User) = not Account.restrict_room_creation or u.role == administrator   // R2
// Not an invariant: "every active user is in every open room". R3 and R9 grant only the
// users active at the time, and N3 restores nothing (scenario n3-unban-misses-new-open-rooms).

predicate same_members(r: Room, users: set of User, me: User) =
  all(.user in users or .user == me for Membership where .room == r) and
  all(member(it, r) for User where it in users or it == me)

// A2, then A1: the banned-address check runs before authentication.
gate blocked_ip: request.method == write and exists(Ban where .ip == request.ip) -> blocked
gate signed_in: not exists(Session where .user == actor) -> unauthenticated

// ---- Sessions and joining

action sign_in(user: User)                                  // A3
{
  skip gate signed_in
  require user.status == active else unauthenticated
  create Session { user: user, ip: request.ip }
}

action join(join_code: Text, name: Text, email: Text)       // D1, D2
{
  skip gate signed_in
  require join_code == Account.join_code else not_found
  require not exists(User where .email == email) else unauthenticated
  create User { name: name, email: email } as user
  create Session { user: user, ip: request.ip }
}

trigger on create User as u {                               // D1
  for each r in Room where .type == open {
    ensure Membership { room: r, user: u }
  }
}

// ---- Rooms

action create_open_room(name: Text?) {
  require may_create_rooms(actor) else forbidden            // R2
  create Room { type: open, name: name, creator: actor } as room
  ensure Membership { room: room, user: actor }             // R3: creator first
}

action create_closed_room(name: Text?, users: set of User) {
  require may_create_rooms(actor) else forbidden            // R2
  create Room { type: closed, name: name, creator: actor } as room
  for each u in User where u in users {                    // R4: only the selected users
    ensure Membership { room: room, user: u }
  }
}

action create_direct_room(users: set of User) {             // R5
  if not exists(Room where .type == direct and same_members(it, users, actor)) {
    create Room { type: direct, creator: actor } as room
    for each u in User where u in users or u == actor {
      ensure Membership { room: room, user: u }
    }
  }
}

action update_open_room(room: Room, name: Text?) {
  require member(actor, room) and room.type != direct else not_found   // R11, R12
  require can_administer(actor, room.creator) else forbidden           // R8
  set room.name = name
  set room.type = open                                                  // R9
}

action update_closed_room(room: Room, name: Text?, users: set of User) {
  require member(actor, room) and room.type != direct else not_found   // R11, R12
  require can_administer(actor, room.creator) else forbidden           // R8
  set room.name = name
  set room.type = closed                                                // R9
  for each u in User where u in users {                               // R10
    ensure Membership { room: room, user: u }
  }
  delete Membership where .room == room and not (.user in users)
}

// R3, R9: a room that is, or becomes, open admits every active user.
trigger on create Room as r when r.type == open {
  for each u in User where .status == active {
    ensure Membership { room: r, user: u }
  }
}
trigger on update Room.type as r when r.type == open and old.type != open {
  for each u in User where .status == active {
    ensure Membership { room: r, user: u }
  }
}
trigger on update Room.type as r when old.type == direct and r.type != direct {   // R11
  reject invalid
}

action delete_room(room: Room) {
  require member(actor, room) else not_found                // R12
  require can_administer(actor, room.creator) else forbidden   // R13
  delete room                                               // R14 by cascades
}

action delete_direct_room(room: Room) {
  require member(actor, room) and room.type == direct else not_found   // R13: any member
  delete room
}

// ---- Memberships

action set_involvement(room: Room, involvement: Involvement) {
  require member(actor, room) else not_found                // M2
  set the(Membership where .room == room and .user == actor).involvement = involvement   // M3 by enum
}

action become_present(room: Room) {                         // U3 (presence channel; model-level)
  require member(actor, room) else not_found
  set the(Membership where .room == room and .user == actor).connected = true
  set the(Membership where .room == room and .user == actor).unread = false
}

// ---- Messages

action post_message(room: Room, body: Text) {
  require member(actor, room) else not_found                // G1
  create Message { room: room, creator: actor, body: body } as message   // G2
}

trigger on create Message as m {                            // U1
  for each ms in Membership where .room == m.room and .user != m.creator and .involvement != invisible and not .connected {
    set ms.unread = true
  }
}

action edit_message(message: Message, body: Text) {
  require member(actor, message.room) else not_found        // G4
  require can_administer(actor, message.creator) else forbidden   // G3
  set message.body = body
}

action delete_message(message: Message) {
  require member(actor, message.room) else not_found        // G4
  require can_administer(actor, message.creator) else forbidden   // G3
  delete message                                            // G5 by cascade
}

permission read Message: member(actor, message.room)

view list_messages(room: Room, before: Message?, after: Message?) {   // G6
  require member(actor, room) else not_found
  rows Message where .room == room and (before == none or .created < before.created) and (after == none or .created > after.created)
  order by created
  window 40 last unless after != none
}

// ---- Boosts

action boost(message: Message, content: Text) {
  require member(actor, message.room) else not_found        // B1
  create Boost { message: message, booster: actor, content: content } as boost   // B2
}

action unboost(boost: Boost) {
  require member(actor, boost.message.room) else not_found  // B1
  require boost.booster == actor else not_found             // B3
  delete boost
}

// ---- Administration

action change_role(user: User, role: Text) {
  require administrator(actor) else forbidden               // P3
  require user.status == active else not_found              // P5
  set user.role = if role == "administrator" { administrator } else { member }   // P4
}

action deactivate_user(user: User) {
  require administrator(actor) else forbidden               // P3
  require user.status == active else not_found              // P5
  delete Membership where .user == user and .room.type != direct   // D3
  delete Session where .user == user
  set user.status = deactivated
  set user.email_deactivated = true                         // D3; D4: messages and boosts stay
}

action ban_user(user: User) {
  require administrator(actor) else forbidden               // P3
  require all(.ip == "" or public_ip(.ip) for Session where .user == user) else invalid   // N2
  for each s in Session where .user == user and .ip != "" {
    ensure Ban { user: user, ip: s.ip }                     // N1
  }
  delete Session where .user == user
  set user.status = banned
  emit UserBanned(user)                                     // N4: memberships stay
}

workflow on UserBanned(u) {
  step remove_messages: delete Message where .creator == u   // N1
}

action unban_user(user: User) {
  require administrator(actor) else forbidden               // P3
  delete Ban where .user == user                             // N3
  set user.status = active
}
