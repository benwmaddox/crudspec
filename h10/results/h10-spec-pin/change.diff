+action pin_message(message: Message) {
+  require member(actor, message.room) else not_found
+  require can_administer(actor, message.creator) else forbidden
+  set message.pinned = true
+  result message
+}
+
+action unpin_message(message: Message) {
+  require member(actor, message.room) else not_found
+  require can_administer(actor, message.creator) else forbidden
+  set message.pinned = false
+  result message
+}
