 screen account_screen "/account/edit" layout app {
package main

import (
	"time"
)

// NextDigestTime calculates the next occurrence of the given hour in the user's timezone.
// It returns the next time that hour occurs after 'now'.
func NextDigestTime(now time.Time, hour int, timeZone string) time.Time {
	// Parse the timezone
	loc, err := time.LoadLocation(timeZone)
	if err != nil {
		// Fall back to UTC if timezone is invalid
		loc = time.UTC
	}

	// Get the current time in the user's timezone
	localNow := now.In(loc)

	// Create a time for today at the target hour in the user's timezone
	digestTime := time.Date(localNow.Year(), localNow.Month(), localNow.Day(),
		hour, 0, 0, 0, loc)

	// If that time has already passed today, schedule for tomorrow
	if digestTime.Before(localNow) || digestTime.Equal(localNow) {
		digestTime = digestTime.Add(24 * time.Hour)
	}

	return digestTime
}
