package main

import (
	"time"
)

// NextDigest computes the next time a digest should be sent.
// It takes the current time, a time-of-day string in HH:MM format,
// and an IANA timezone name, and returns the next occurrence of that time.
func NextDigest(now time.Time, hhmm, zone string) time.Time {
	if hhmm == "" || zone == "" {
		return time.Time{}
	}

	// Parse the timezone
	loc, err := time.LoadLocation(zone)
	if err != nil {
		return time.Time{}
	}

	// Parse HH:MM
	t, err := time.Parse("15:04", hhmm)
	if err != nil {
		return time.Time{}
	}
	hour, minute := t.Hour(), t.Minute()

	// Convert now to the user's timezone
	nowInZone := now.In(loc)

	// Create a time for today at the specified hour:minute in the user's timezone
	next := time.Date(
		nowInZone.Year(),
		nowInZone.Month(),
		nowInZone.Day(),
		hour,
		minute,
		0,
		0,
		loc,
	)

	// If that time has already passed today, move to tomorrow
	if next.Before(nowInZone) || next.Equal(nowInZone) {
		next = next.AddDate(0, 0, 1)
	}

	return next
}
