// Desk: a support helpdesk where customers ask for help and staff answer.

enum UserRole { staff, customer }
enum TicketStatus { open, pending, solved }

entity User {
  name: Text
  email: Email
  password: Password
  role: UserRole
  unique (email)
}

entity Session {
  user: User on delete cascade
  token: Text = token(24)
  unique (token)
}

entity Ticket {
  customer: User on delete cascade on change touch
  subject: Text
  description: Text
  status: TicketStatus = open
  assigned_to: User?
}

entity TicketMessage {
  ticket: Ticket on delete cascade on change touch
  author: User on delete cascade
  body: Text
  is_note: Bool = false
}

app desk {
  name "Desk"
  actor User
  sign_in sign_in_screen
  setup setup_screen
  setup_when not exists(User)
}

display User: .name
avatar User: initials(.name)

theme desk {
  stylesheets ["desk.css"]
  classes { button: "btn", submit: "btn-primary", plain_button: "btn-plain", row: "row", column: "column", form: "form", field: "field", input: "input", heading: "heading", screen_reader: "sr-only" }
}

identity session: Session.token from cookie "session_token"
identity agent: User from token

gate signed_in: actor == none -> unauthenticated

predicate can_read_session(s: Session) = s.user == actor
predicate can_read_ticket(t: Ticket) = t.customer == actor or actor.role == staff
predicate can_read_message(m: TicketMessage) = m.ticket.customer == actor or actor.role == staff
predicate can_view_ticket(t: Ticket) = t.customer == actor or actor.role == staff

permission read User: true
permission read Session: can_read_session(session)
permission read Ticket: can_read_ticket(ticket)
permission read TicketMessage: can_read_message(ticket_message)

// ---- Setup and authentication

action setup(name: Text, email: Email, password: Text)
{
  skip gate signed_in
  rate_limit 5 per 1 h by request.ip else blocked
  require not exists(User) else invalid
  require not exists(User where .email == email) else invalid
  create User { name: name, email: email, password: password, role: staff } as u
  create Session { user: u } as s
  result s
}

action sign_up(name: Text, email: Email, password: Text)
{
  skip gate signed_in
  rate_limit 10 per 1 h by request.ip else blocked
  require not exists(User where .email == email) else invalid
  create User { name: name, email: email, password: password, role: customer } as u
  create Session { user: u } as s
  result s
}

action sign_in(email: Email, password: Text)
{
  skip gate signed_in
  rate_limit 20 per 1 h by request.ip else blocked
  let u = the_or_none(User where .email == email)
  require u != none and authenticates(u.password, password) else unauthenticated
  create Session { user: u } as s
  result s
}

action sign_out() {
  delete Session where .token == request.session_token
}

// ---- Tickets

action create_ticket(subject: Text, description: Text) {
  require actor != none else unauthenticated
  require actor.role == customer else forbidden
  require present(subject) else invalid
  create Ticket { customer: actor, subject: subject, description: description } as t
  result t
}

action add_reply(ticket: Ticket, body: Text) {
  require actor != none else unauthenticated
  require ticket.customer == actor or actor.role == staff else not_found
  require present(body) else invalid
  create TicketMessage { ticket: ticket, author: actor, body: body, is_note: false } as m
  // If customer replies to pending/solved, reopen
  if ticket.status != open and actor.role == customer {
    set ticket.status = open
  }
  result m
}

action add_note(ticket: Ticket, body: Text) {
  require actor != none else unauthenticated
  require actor.role == staff else forbidden
  require ticket.customer == actor or actor.role == staff else not_found
  require present(body) else invalid
  create TicketMessage { ticket: ticket, author: actor, body: body, is_note: true } as m
  result m
}

action assign_ticket(ticket: Ticket) {
  require actor != none else unauthenticated
  require actor.role == staff else forbidden
  require ticket.customer == actor or actor.role == staff else not_found
  set ticket.assigned_to = actor
}

action mark_pending(ticket: Ticket) {
  require actor != none else unauthenticated
  require actor.role == staff else forbidden
  require ticket.customer == actor or actor.role == staff else not_found
  set ticket.status = pending
}

action mark_solved(ticket: Ticket) {
  require actor != none else unauthenticated
  require actor.role == staff else forbidden
  require ticket.customer == actor or actor.role == staff else not_found
  set ticket.status = solved
}

action reopen_ticket(ticket: Ticket) {
  require actor != none else unauthenticated
  require actor.role == staff else forbidden
  require ticket.customer == actor or actor.role == staff else not_found
  require ticket.status == solved else invalid
  set ticket.status = open
}

// ---- Views

view my_tickets() {
  updates live
  require actor != none else unauthenticated
  require actor.role == customer else not_found
  rows Ticket where .customer == actor
  order by created desc
}

view ticket_queue() {
  updates live
  require actor != none else unauthenticated
  require actor.role == staff else not_found
  rows Ticket where .status != solved
  order by created
}

view ticket_messages(ticket: Ticket) {
  updates live
  require actor != none else unauthenticated
  require ticket.customer == actor or actor.role == staff else not_found
  rows TicketMessage where .ticket == ticket and (not .is_note or actor.role == staff)
  order by created
}

// ---- UI

layout app {
  <Title />
  <Nav>
    <Slot name=nav />
  </Nav>
  <Flash />
  <Main>
    <Slot name=main />
  </Main>
}

screen setup_screen {
  route "/setup"
  layout app
  access public
  <Title>Set up Desk</Title>
  <Nav>
    <Text>Desk</Text>
  </Nav>
  <Main>
    <Section class="card">
      <Heading>Welcome to Desk</Heading>
      <Text>Create your staff account to set up the helpdesk.</Text>
      <Form action={setup}>
        <Field name=name kind=text placeholder="Name" required />
        <Field name=email kind=email placeholder="Email address" required />
        <Field name=password kind=password placeholder="Password" required />
        <Submit label="Create account" />
        <On ok go={home} />
        <On invalid flash="That email is already in use." />
      </Form>
    </Section>
  </Main>
}

screen sign_in_screen {
  route "/sign-in"
  layout app
  access public
  <Title>Sign in to Desk</Title>
  <Nav>
    <Text>Desk</Text>
  </Nav>
  <Main>
    <Section class="card">
      <Heading>Sign in</Heading>
      <Form action={sign_in}>
        <Field name=email kind=email placeholder="Email address" required />
        <Field name=password kind=password placeholder="Password" required />
        <Submit label="Sign in" />
        <On ok go={home} />
        <On unauthenticated flash="Wrong email or password." />
      </Form>
      <Link to={sign_up_screen()} class="link">
        <Text>Sign up</Text>
      </Link>
    </Section>
  </Main>
}

screen sign_up_screen {
  route "/sign-up"
  layout app
  access public
  <Title>Create customer account</Title>
  <Nav>
    <Text>Desk</Text>
  </Nav>
  <Main>
    <Section class="card">
      <Heading>Create your account</Heading>
      <Form action={sign_up}>
        <Field name=name kind=text placeholder="Name" required />
        <Field name=email kind=email placeholder="Email address" required />
        <Field name=password kind=password placeholder="Password" required />
        <Submit label="Sign up" />
        <On ok go={home} />
        <On invalid flash="That email is already in use." />
      </Form>
      <Link to={sign_in_screen()} class="link">
        <Text>I have an account</Text>
      </Link>
    </Section>
  </Main>
}

screen home {
  route "/"
  layout app
  <Title>Desk</Title>
  <Nav>
    <TopBar />
  </Nav>
  <Main>
    if actor.role == customer {
      <CustomerHome />
    } else {
      <StaffHome />
    }
  </Main>
}

component TopBar() {
  <Row class="bar">
    <Link to={home} class="brand">
      <Text>Desk</Text>
    </Link>
    <Row class="who">
      <Avatar>{actor}</Avatar>
      <Text>{actor.name}</Text>
      <Button action={sign_out()} label="Sign out" class="btn-plain" />
      <On ok go={sign_in_screen()} />
    </Row>
  </Row>
}

component CustomerHome() {
  <Section class="card">
    <Heading>Your tickets</Heading>
    <List of={my_tickets()} as=t class="list">
      <Link to={ticket_screen(t)} class="row">
        <Strong>{t.subject}</Strong>
        <Text class="status">{text(t.status)}</Text>
      </Link>
    </List>
    <Link to={new_ticket_screen()} class="btn">
      <Text>New ticket</Text>
    </Link>
  </Section>
}

component StaffHome() {
  <Section class="card">
    <Heading>Queue</Heading>
    <List of={ticket_queue()} as=t class="list">
      <Link to={ticket_screen(t)} class="row">
        <Strong>{t.subject}</Strong>
        <Text class="status">{text(t.status)}</Text>
        <Text class="muted">{t.customer.name}</Text>
      </Link>
    </List>
  </Section>
}

screen new_ticket_screen {
  route "/tickets/new"
  layout app
  <Title>New ticket</Title>
  <Nav>
    <TopBar />
  </Nav>
  <Main>
    <Section class="card">
      <Heading>New ticket</Heading>
      <Form action={create_ticket}>
        <Field name=subject kind=text placeholder="Subject" required />
        <Field name=description kind=text placeholder="Description" required />
        <Submit label="Submit ticket" />
        <On ok go={ticket_screen(result)} />
      </Form>
    </Section>
  </Main>
}

screen ticket_screen(ticket: Ticket) {
  route "/tickets/:ticket"
  layout app
  require can_view_ticket(ticket) else go home flash "Ticket not found."
  <Title>{ticket.subject}</Title>
  <Nav>
    <TopBar />
  </Nav>
  <Main>
    <Section class="card">
      <Link to={home} class="quiet">
        <Text>← Back</Text>
      </Link>
      <Heading>{ticket.subject}</Heading>
      <Row class="meta">
        <Text>{"Status: " + text(ticket.status)}</Text>
        if ticket.assigned_to != none {
          <Text>{"Assigned to: " + ticket.assigned_to.name}</Text>
        }
      </Row>
      <Row class="description">
        <Text>{ticket.description}</Text>
      </Row>
    </Section>

    <Section class="card">
      <Heading>Conversation</Heading>
      <List of={ticket_messages(ticket)} as=m class="list">
        <Row class={"message " + if m.is_note { "note" } else { "reply" }}>
          <Avatar>{m.author}</Avatar>
          <Column>
            <Strong>{m.author.name}</Strong>
            if m.is_note {
              <Text class="note-label">(Internal note)</Text>
            }
            <Text>{m.body}</Text>
          </Column>
        </Row>
      </List>
    </Section>

    if actor.role == staff {
      <StaffTicketControls ticket={ticket} />
    } else {
      <CustomerTicketControls ticket={ticket} />
    }
  </Main>
}

component StaffTicketControls(ticket: Ticket) {
  <Section class="card">
    <Heading>Staff actions</Heading>

    if ticket.assigned_to != actor {
      <Form action={assign_ticket(ticket)} class="inline">
        <Submit label="Assign to me" />
        <On ok stay />
      </Form>
    }

    <Form action={mark_pending(ticket)} class="inline">
      <Submit label="Mark pending" />
      <On ok stay />
    </Form>

    <Form action={mark_solved(ticket)} class="inline">
      <Submit label="Mark solved" />
      <On ok stay />
    </Form>

    if ticket.status == solved {
      <Form action={reopen_ticket(ticket)} class="inline">
        <Submit label="Reopen" />
        <On ok stay />
      </Form>
    }

    <Section class="card">
      <Heading>Reply</Heading>
      <Form action={add_reply(ticket)} class="inline">
        <Field name=body kind=text placeholder="Reply" required />
        <Submit label="Send reply" />
        <On ok stay />
      </Form>
    </Section>

    <Section class="card">
      <Heading>Note</Heading>
      <Form action={add_note(ticket)} class="inline">
        <Field name=body kind=text placeholder="Note" required />
        <Submit label="Add note" />
        <On ok stay />
      </Form>
    </Section>
  </Section>
}

component CustomerTicketControls(ticket: Ticket) {
  <Section class="card">
    <Heading>Reply</Heading>
    <Form action={add_reply(ticket)} class="inline">
      <Field name=body kind=text placeholder="Reply" required />
      <Submit label="Send reply" />
      <On ok stay />
    </Form>
  </Section>
}
