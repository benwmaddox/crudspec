// Game Wiki: wikis about games, many on one install. Each wiki has its own pages, images,
// members and settings, and is public (anyone reads it) or private (members only). A site
// administrator runs the install: who may create wikis, the base domain wikis live under, and
// the ads. A wiki administrator runs one wiki: its members and their roles, who may edit, its
// infobox templates. Pages are Markdown with [[Page]] links, keep every revision, and belong to
// categories; an infobox gives a page typed facts (an item's damage, a boss's weak point).

app gamewiki {
  name "Game Wiki"
  about "Wikis for games: pages, infoboxes, images and categories, public or private, many wikis on one install"
  actor User
  sign_in_screen sign_in_screen
  setup_screen first_run_screen
  setup_when not exists(User)
  admin actor.site_admin
  indexes auto
  // AI agents (/llms.txt, MCP at /_mcp): people issue tokens at /_agents; the site administrator
  // switches the interface on or off, and whether agents may read public wikis without a token
  agents_when Site.agents_enabled
  agents_anonymous Site.agents_read_without_token
  agent_calls_per_minute 60
  agent_writes_per_minute 10
}

enum Role { reader "Reader", editor "Editor", admin "Wiki admin", blocked "Blocked" }
// who may change a page, beyond who may edit the wiki
enum Protection { open "Anyone who can edit the wiki", editors "Members who are editors", admins "Wiki admins only" }
enum Visibility { public "Public: anyone can read it", private "Private: members only" }
enum EditMode { members "Members who are editors", anyone "Anyone signed in" }
enum Accent { violet "Violet", blue "Blue", cyan "Cyan", emerald "Emerald", amber "Amber", rose "Rose" }   // a wiki's color
enum AdPlacement { header "Top of the page", sidebar "Sidebar", article "End of an article" }
enum AdKind { house "House ad: an image and a link", network "Ad network unit (AdSense)", code "Ad code from a network (shown in a sandboxed frame)" }

// ---------------------------------------------------------------- the install

singleton Site {
  name: Text max 80 = "Game Wiki"
  tagline: Text? max 160
  base_domain: Text? max 120                  // wikis at <slug>.<base_domain>, as well as /w/<slug>
  open_signups: Bool = true
  anyone_can_create_wikis: Bool = true        // otherwise site administrators create them
  ads_enabled: Bool = false
  wiki_admins_can_turn_off_ads: Bool = false
  agents_enabled: Bool = true                 // the agent interface answers (tokens people issue at /_agents)
  agents_read_without_token: Bool = true      // agents may read public wikis with no token, as a visitor does
}

entity User {
  name: Text max 80
  email: Email private
  password: Password max 72
  site_admin: Bool = false
  watch_seen: Time? private                   // when they last marked their watchlist seen
  watch_unseen: Int? private                  // changes and comments on watched pages since then (none: 0)
  unique (email)
}

entity Login {
  user: User on delete cascade
  token: Text = token(24)
  unique (token)
}

entity AdSlot {
  placement: AdPlacement
  kind: AdKind
  label: Text max 80                          // for site admins' list
  image: File?                                // house ad
  link: Url?                                  // house ad
  alt: Text? max 160                          // house ad
  network_client: Text? max 80                // AdSense: ca-pub-…
  network_unit: Text? max 40                  // AdSense: the ad unit's slot id
  code: Text? max 8000                        // a network's ad code, run in a sandboxed frame
  active: Bool = true
}

// ---------------------------------------------------------------- a wiki

entity Wiki {
  slug: Text min 2 max 40
  name: Text max 80
  tagline: Text? max 160
  game: Text? max 80                          // the game it's about
  logo: File?
  banner: File?                               // a wide picture across the top of its main page and its card
  accent: Accent = violet
  visibility: Visibility = public
  edit_mode: EditMode = members
  custom_domain: Text? max 120                // a domain of its own, pointed at this install
  ads_off: Bool = false                       // honored when the site lets wiki admins turn ads off
  owner: User on delete restrict
  unique (slug)
  unique (custom_domain)
  address slug                                // its pages are at /w/<slug>/…
  invariant valid_slug(self.slug)
}

entity Membership {
  wiki: Wiki on delete cascade
  user: User on delete cascade
  role: Role = editor
  unique (wiki, user)
  invariant self.user != self.wiki.owner or self.role == admin   // a wiki's owner stays its administrator
}

entity Page {
  wiki: Wiki on delete cascade
  title: Text max 120 searchable
  key: Text max 120                           // the title in lower case: titles are unique in any case
  body: Text max 200000 searchable            // Markdown
  game_version: Text? max 40                  // the patch or version it describes
  spoilers: Bool = false
  protection: Protection = open
  last_editor: User? on delete nullify        // who changed it last (undo_edits_by)
  image: File?                                // the infobox's picture
  infobox: InfoboxTemplate? on delete nullify
  revisions: Int = 1
  unique (wiki, key)
  invariant self.key == lower(self.title)
  invariant self.infobox == none or self.infobox.wiki == self.wiki
}

entity Revision {
  page: Page on delete cascade on change touch
  number: Int
  title: Text max 120
  body: Text max 200000
  summary: Text? max 200
  author: User? on delete nullify
  // the page's infobox as it was: its template, its picture and its facts (RevisionFact), copied as
  // the revision is made. Revisions from before infoboxes were kept have infobox_kept false.
  infobox_kept: Bool = false
  infobox: InfoboxTemplate? on delete nullify
  image: File?
  unique (page, number)
}

// One infobox fact of a page as it was at a revision. A field taken off its template later is
// none here, and its label stays for the history.
entity RevisionFact {
  revision: Revision on delete cascade
  field: InfoboxField? on delete nullify
  label: Text max 60
  value: Text max 400
}

// Another name a page is found by: a redirect. A link or address with it shows the page. Renaming
// a page keeps its old title as one, so links to it keep working.
entity PageName {
  page: Page on delete cascade
  wiki: Wiki on delete cascade                // the page's
  name: Text max 120 searchable
  key: Text max 120
  unique (wiki, key)
  invariant self.key == lower(self.name)
  invariant self.wiki == self.page.wiki
}

// Someone watching a page: its changes and its talk show on their watchlist. Their own.
entity Watch {
  user: User on delete cascade
  page: Page on delete cascade
  wiki: Wiki on delete cascade                // the page's
  unique (user, page)
  invariant self.wiki == self.page.wiki
}

// A comment on a page's talk: Markdown, by someone who may edit the wiki.
entity Comment {
  page: Page on delete cascade
  wiki: Wiki on delete cascade                // the page's
  author: User? on delete nullify
  body: Text max 20000
  invariant self.wiki == self.page.wiki
  index (page)
}

entity PageCategory {
  page: Page on delete cascade
  wiki: Wiki on delete cascade                // the page's, so a category's pages are one index away
  name: Text max 60
  key: Text max 60
  unique (page, key)
  invariant self.key == lower(self.name)
  invariant self.wiki == self.page.wiki
  index (wiki, key)
}

entity Upload {
  wiki: Wiki on delete cascade
  file: File
  name: Text? max 120                         // what pages call it: [[File:Name.png]]
  caption: Text? max 200
  uploader: User? on delete nullify
  unique (wiki, name)
}

// uploads from before images had names are called by their file's name
migration "upload names" {
  for each u in Upload where .name == none {
    if exists(Upload where .wiki == u.wiki and .name == u.file.filename) { set u.name = text(u.id) + " " + u.file.filename } else { set u.name = u.file.filename }
  }
}

entity InfoboxTemplate {
  wiki: Wiki on delete cascade
  name: Text max 60
  key: Text max 60
  unique (wiki, key)
  invariant self.key == lower(self.name)
}

entity InfoboxField {
  template: InfoboxTemplate on delete cascade
  label: Text max 60
  position: Int = 0
}

entity InfoboxValue {
  page: Page on delete cascade on change touch
  field: InfoboxField on delete cascade
  value: Text max 400
  unique (page, field)
}

// ---------------------------------------------------------------- identity

identity login: Login.token from cookie "login"
identity agent: User from token

show User {
  label: .name
  picture: initials(.name)
}

// ---------------------------------------------------------------- rules

// a page title: no [ ] | (they'd break [[links]]); a / makes a subpage (Damage/Cost), so not at
// the start or end, nor twice in a row, and no part that is . or .. (a browser would make the
// address another one)
fn valid_title(t: Text): Bool =
  present(t) and not contains(t, "[") and not contains(t, "]") and not contains(t, "|")
    and not contains("/" + trim(t) + "/", "/./") and not contains("/" + trim(t) + "/", "/../")
    and not starts_with(trim(t), "/") and present(after_last(trim(t), "/")) and not contains(t, "//")
fn valid_slug(s: Text): Bool = s == lower(trim(s)) and not contains(s, " ") and not contains(s, "/") and not contains(s, ".")
// addresses a new wiki can't take: with a base domain, a wiki's address is a subdomain, and these are
// the site's own or look like it
fn reserved_slug(s: Text): Bool = contains(" www api app admin administrator mail email smtp imap pop ftp ns ns1 ns2 cdn static assets files media img images auth login signin signup account accounts help support status docs blog site wiki wikis root security abuse postmaster webmaster hostmaster ", " " + s + " ")
fn site_admin(u: User?): Bool = u != none and u.site_admin

query member(u: User?, w: Wiki): Bool = exists(Membership where .wiki == w and .user == u)
query wiki_admin(u: User?, w: Wiki): Bool = site_admin(u) or exists(Membership where .wiki == w and .user == u and .role == admin)
query can_read(u: User?, w: Wiki): Bool = w.visibility == public or site_admin(u) or member(u, w)
query blocked_in(u: User?, w: Wiki): Bool = exists(Membership where .wiki == w and .user == u and .role == blocked)
query editor_member(u: User?, w: Wiki): Bool = exists(Membership where .wiki == w and .user == u and (.role == editor or .role == admin))
// who may edit a wiki: its editors and admins, or anyone signed in when it says so; never someone blocked there
query can_edit(u: User?, w: Wiki): Bool =
  u != none and (site_admin(u) or (not blocked_in(u, w) and (editor_member(u, w)
    or (w.edit_mode == anyone and (w.visibility == public or member(u, w))))))
// who may change a page: who may edit its wiki, as far as the page's protection lets them
query can_change(u: User?, p: Page with .wiki): Bool =
  can_edit(u, p.wiki) and (p.protection == open or wiki_admin(u, p.wiki) or (p.protection == editors and editor_member(u, p.wiki)))
fn may_create_wikis(u: User?): Bool = u != none and (Site.anyone_can_create_wikis or u.site_admin)
// ads show on public wikis only, when the site has them on and the wiki hasn't turned them off
fn shows_ads(w: Wiki?): Bool = Site.ads_enabled and (w == none or (w.visibility == public and not (w.ads_off and Site.wiki_admins_can_turn_off_ads)))

// the image a name calls, in any case ([[File:Name.png]])
query image_named(w: Wiki, name: Text): Upload? = first_or_none(Upload where .wiki == w and lower(.name) == lower(trim(name)) order by .id)
// what a page shows for {{Name}} and [[File:Name]]: the page's text, the image's address
query page_text(w: Wiki, name: Text): Text? = the_or_none(Page where .wiki == w and .key == page_key(w, name)).body
query image_url(w: Wiki, name: Text): Text? = first(list(path(url_of(.file)) for Upload where .wiki == w and lower(.name) == lower(trim(name))))

// the page a title names: its own title, or one of its other names (in any case)
query page_named(w: Wiki, title: Text): Page? =
  the_or_none(Page where .wiki == w and .key == page_key(w, title) with .wiki, .infobox)
// the key of the page a title names: the page another name points to, or the title's own
query page_key(w: Wiki, title: Text): Text =
  the_or_none(PageName where .wiki == w and .key == lower(trim(title)) with .page).page.key.default(lower(trim(title)))
// the wiki a request's address names: its own domain, or <slug>.<the site's base domain>
query wiki_for_host(): Wiki? =
  if exists(Wiki where .custom_domain == request.host) { the_or_none(Wiki where .custom_domain == request.host) }
  else { the_or_none(Wiki where .slug == subdomain_of(request.host, Site.base_domain)) }
// zelda.wikis.example.com under wikis.example.com is zelda
fn subdomain_of(host: Text?, base: Text?): Text? =
  if host != none and base != none and present(base) and replace(host, "." + base, "") + "." + base == host and not contains(replace(host, "." + base, ""), ".") { replace(host, "." + base, "") } else { none }
// a wiki's own domain mustn't be the site's base domain or a name under it (another wiki's)
fn domain_free(d: Text): Bool = d != Site.base_domain.default("") and subdomain_of(d, Site.base_domain) == none and not (Site.base_domain != none and contains(d, "." + Site.base_domain.default("")))
// where [[links]] go: the page screen's address with no title, so the compiler checks it
fn wiki_links(w: Wiki): Text = path(url_of(page_screen(w, "")))
// the titles of a wiki's pages: its [[links]] to others are shown as pages still to write
query page_titles(w: Wiki): list of Text = list(.title for Page where .wiki == w) + list(.name for PageName where .wiki == w)
// a wiki's uploads for the editor's image picker: "address|caption", one a line, newest first
// the editor's image picker: "address|name" each, newest first
query image_lines(w: Wiki): Text = join(in_app(list(path(url_of(.file)) + "|" + .name.default(.file.filename) for Upload where .wiki == w order by created desc limit 60)), "\n")
// the class that gives a wiki its color (wiki.css)
// a revision's infobox facts as lines of text, for the history's diff
query infobox_lines(r: Revision): Text =
  join(list(.label + ": " + .value for RevisionFact where .revision == r order by .label), "\n")
fn accent_class(w: Wiki): Text = "accent-" + text(w.accent)

// a wiki and everything in it: anyone for a public wiki, its members for a private one
policy wiki_rows: can_read(actor, wiki) for rows in Wiki
policy user_rows: true for rows of User
policy login_rows: .user == actor for rows of Login
policy watch_rows: .user == actor for rows of Watch
policy ad_rows: true for rows of AdSlot

policy page_writes: can_change(actor, it) else forbidden for writes to Page
policy upload_writes: can_edit(actor, .wiki) else forbidden for writes to Upload
policy wiki_writes: wiki_admin(actor, it) else forbidden for writes to Wiki
// a wiki keeps its main page, however a page is deleted (deleting the wiki takes it with the rest)
policy main_page_stays: .key != "main page" else invalid for deletes of Page
// a blocked member's row is the block, so only an administrator may take it away
policy blocks_stay: .role != blocked or wiki_admin(actor, .wiki) else forbidden for deletes of Membership

// ---------------------------------------------------------------- accounts

// The first account: it runs the install.
action first_run(name: Text, email: Email, password: Text) {
  callers people
  require not exists(User) else forbidden
  require present(name) and length(password) >= 8 else invalid "a name, and a password of 8 characters or more"
  if not exists(Site) { create Site { } }
  create User { name: name, email: email, password: password, site_admin: true } as u
  create Login { user: u } as l
  result l
}

// Makes an account and signs it in, while the site takes sign-ups.
action sign_up(name: Text, email: Email, password: Text) {
  callers people
  rate_limit 10 per Duration.minutes(5) by request.ip else blocked
  require Site.open_signups else forbidden "sign-ups are closed"
  require present(name) and length(password) >= 8 else invalid "a name, and a password of 8 characters or more"
  require not exists(User where .email == email) else invalid "that email has an account"
  create User { name: name, email: email, password: password } as u
  create Login { user: u } as l
  result l
}

action sign_in(email: Email, password: Text) {
  callers people
  rate_limit 10 per Duration.minutes(3) by request.ip else blocked
  // per account too, so changing address (or many machines) doesn't buy more guesses at one password
  rate_limit 20 per Duration.minutes(15) by lower(trim(email)) else blocked
  let u = the_or_none(User where .email == email)
  require u != none and authenticates(u.password, password) else unauthenticated
  create Login { user: u } as l
  result l
}

action sign_out() {
  callers people
  delete Login where .token == request.session_token
}

// ---------------------------------------------------------------- wikis

// Starts a wiki, with you as its administrator and a main page to edit.
action create_wiki(slug: Text, name: Text, game: Text?, visibility: Visibility) {
  require actor != none else unauthenticated
  require may_create_wikis(actor) else forbidden "only site administrators create wikis here"
  require valid_slug(slug) and length(slug) >= 2 else invalid "an address of lower-case letters, digits and dashes"
  require not reserved_slug(slug) else invalid "that address is reserved"
  require not exists(Wiki where .slug == slug) else invalid "that address is taken"
  require present(name) else invalid
  create Wiki { slug: slug, name: name, game: if present(game) { game } else { none }, visibility: visibility, owner: actor } as w
  create Membership { wiki: w, user: actor, role: admin }
  create Page { wiki: w, last_editor: actor, title: "Main Page", key: "main page", body: "# " + name + "\n\nWelcome! Edit this page to say what the wiki covers, and link to its first pages, like [[Characters]] or [[Items]]." } as p
  create Revision { page: p, number: 1, title: p.title, body: p.body, summary: "Created the wiki", author: actor }
  result w
}

// Changes a wiki's name, look, who reads and edits it, its own domain and (when the site allows) its ads. Wiki administrators.
action update_wiki(wiki: Wiki, name: Text, tagline: Text?, game: Text?, visibility: Visibility, edit_mode: EditMode, ads_off: Bool, logo: File?, banner: File?, accent: Accent?) {
  require present(name) else invalid
  set wiki.name = name
  set wiki.tagline = if present(tagline) { tagline } else { none }
  set wiki.game = if present(game) { game } else { none }
  set wiki.visibility = visibility
  set wiki.edit_mode = edit_mode
  set wiki.ads_off = ads_off
  if logo != none { set wiki.logo = logo }
  if banner != none { set wiki.banner = banner }
  if accent != none { set wiki.accent = accent }
}

// Gives a wiki a domain of its own (its DNS pointed at this install), or takes it away. Site
// administrators: a domain needs the operator's DNS and certificates, and must not be the
// site's or another wiki's.
action set_wiki_domain(wiki: Wiki, custom_domain: Text?) {
  skip policy wiki_writes
  require site_admin(actor) else forbidden
  require not present(custom_domain) or (contains(custom_domain, ".") and not contains(custom_domain, "/") and not contains(trim(custom_domain), " ") and not contains(custom_domain, ":")) else invalid "a domain name, like wiki.mygame.com"
  require not present(custom_domain) or domain_free(lower(trim(custom_domain))) else invalid "that's the site's domain, or a wiki's under it"
  set wiki.custom_domain = if present(custom_domain) { lower(trim(custom_domain)) } else { none }
}

// Takes a wiki's logo or banner off.
action remove_wiki_picture(wiki: Wiki, which: Text) {
  require which == "logo" or which == "banner" else invalid
  if which == "logo" { set wiki.logo = none } else { set wiki.banner = none }
}

// Deletes a wiki and everything in it. Its owner or a site administrator.
action delete_wiki(wiki: Wiki, confirm_slug: Text) {
  skip policy wiki_writes
  require wiki.owner == actor or site_admin(actor) else forbidden
  require confirm_slug == wiki.slug else invalid "type the wiki's address to delete it"
  delete wiki
}

// ---------------------------------------------------------------- members

// Adds someone by email, or changes their role.
action add_member(wiki: Wiki, email: Email, role: Role) {
  require wiki_admin(actor, wiki) else forbidden
  let u = the_or_none(User where .email == email)
  require u != none else invalid "no one with that email has an account"
  ensure Membership { wiki: wiki, user: u, role: role } as m
  set m.role = role
}

// Changes a member's role: reader, editor or wiki admin.
action set_role(m: Membership with .wiki, role: Role) {
  require wiki_admin(actor, m.wiki) else forbidden
  require m.user != m.wiki.owner or role == admin else invalid "the wiki's owner stays an administrator"
  set m.role = role
}

// Takes someone out of a wiki (or yourself); the owner stays.
action remove_member(m: Membership with .wiki) {
  require wiki_admin(actor, m.wiki) or m.user == actor else forbidden
  require m.user != m.wiki.owner else invalid "the wiki's owner can't be removed"
  delete m
}

// Joins a public wiki as an editor, where anyone signed in may edit it.
action join_wiki(wiki: Wiki) {
  require actor != none else unauthenticated
  require wiki.visibility == public and wiki.edit_mode == anyone else forbidden
  require not blocked_in(actor, wiki) else forbidden "you are blocked on this wiki"
  ensure Membership { wiki: wiki, user: actor, role: editor }
}

// ---------------------------------------------------------------- pages

// Writes a new page.
action create_page(wiki: Wiki, title: Text, body: Text, summary: Text?, categories: Text?, game_version: Text?, spoilers: Bool, image: File?) {
  require actor != none else unauthenticated
  require can_edit(actor, wiki) else forbidden
  require valid_title(title) else invalid "a title without [ ] or |, and no / at its start or end or twice in a row"
  require page_named(wiki, title) == none else invalid "a page with that title exists"
  create Page { wiki: wiki, last_editor: actor, title: trim(title), key: lower(trim(title)), body: body, game_version: if present(game_version) { game_version } else { none }, spoilers: spoilers, image: image } as p
  create Revision { page: p, number: 1, title: p.title, body: body, summary: if present(summary) { summary } else { "Created the page" }, author: actor }
  ensure Watch { user: actor, page: p, wiki: wiki }
  if present(categories) {
    for each c in split(categories, ",") {
      if present(trim(c)) { ensure PageCategory { page: p, wiki: wiki, name: trim(c), key: lower(trim(c)) } }
    }
  }
  result p
}

// Saves a new revision of a page: its title, text, categories and details. base is the page's
// revisions count when the editor read it (all_pages and search_pages give it): a save over a newer
// revision is refused as a conflict, so no one's edit is lost unseen.
action edit_page(page: Page with .wiki, base: Int, title: Text, body: Text, summary: Text?, categories: Text?, game_version: Text?, spoilers: Bool, image: File?) {
  rate_limit 30 per Duration.minutes(10) by actor.email else blocked
  require page.revisions == base else conflict "the page was saved by someone else since; read its history, then save again"
  require valid_title(title) else invalid "a title without [ ] or |, and no / at its start or end or twice in a row"
  require lower(trim(title)) == page.key or page_named(page.wiki, title) == none or page_named(page.wiki, title) == page else invalid "a page with that title exists"
  set page.key = lower(trim(title))                 // (the key first: a rename keeps the old title, below)
  set page.title = trim(title)
  set page.body = body
  set page.game_version = if present(game_version) { game_version } else { none }
  set page.spoilers = spoilers
  if image != none { set page.image = image }
  set page.revisions = page.revisions + 1
  set page.last_editor = actor
  create Revision { page: page, number: page.revisions, title: trim(title), body: body, summary: if present(summary) { summary } else { none }, author: actor }
  ensure Watch { user: actor, page: page, wiki: page.wiki }
  delete PageCategory where .page == page
  if present(categories) {
    for each c in split(categories, ",") {
      if present(trim(c)) { ensure PageCategory { page: page, wiki: page.wiki, name: trim(c), key: lower(trim(c)) } }
    }
  }
}

// Puts a page's text back as it was at an earlier revision, as a new revision.
action revert_to(r: Revision with .page, .page.wiki) {
  require can_edit(actor, r.page.wiki) else forbidden
  require lower(r.title) == r.page.key or page_named(r.page.wiki, r.title) == none or page_named(r.page.wiki, r.title) == r.page else invalid "another page has that title now"
  let page = r.page
  set page.key = lower(r.title)
  set page.title = r.title
  set page.body = r.body
  if r.infobox_kept {
    set page.infobox = r.infobox
    set page.image = r.image
    delete InfoboxValue where .page == page
    for each f in RevisionFact where .revision == r and .field != none { create InfoboxValue { page: page, field: f.field, value: f.value } }
  }
  set page.revisions = page.revisions + 1
  set page.last_editor = actor
  create Revision { page: page, number: page.revisions, title: r.title, body: r.body, summary: "Reverted to revision " + text(r.number), author: actor }
}

// Takes the picture off a page's infobox.
action remove_page_image(page: Page with .wiki) {
  set page.image = none
  set page.revisions = page.revisions + 1
  set page.last_editor = actor
  create Revision { page: page, number: page.revisions, title: page.title, body: page.body, summary: "Took the infobox image off", author: actor }
}

// Sets who may change a page: anyone who can edit the wiki, members who are editors, or wiki admins only.
action set_protection(page: Page with .wiki, protection: Protection) {
  require wiki_admin(actor, page.wiki) else forbidden
  set page.protection = protection
}

// Undoes everything someone changed last on a wiki's pages: each page they were the last to
// change goes back to the last revision by anyone else, as a new revision, and a page only they
// ever wrote is deleted. Wiki administrators, for vandalism; block them on Members too.
action undo_edits_by(wiki: Wiki, user: User) {
  require wiki_admin(actor, wiki) else forbidden
  require user != actor else invalid "that's you"
  require user != wiki.owner or site_admin(actor) else forbidden "the owner's edits are undone by hand, or by a site administrator"
  for each p in Page where .wiki == wiki and .last_editor == user with .wiki {
    let good = first_or_none(Revision where .page == p and (.author == none or .author != user) order by .number desc)
    if good != none {
      set p.key = lower(good.title)
      set p.title = good.title
      set p.body = good.body
      if good.infobox_kept {
        set p.infobox = good.infobox
        set p.image = good.image
        delete InfoboxValue where .page == p
        for each f in RevisionFact where .revision == good and .field != none { create InfoboxValue { page: p, field: f.field, value: f.value } }
      }
      set p.revisions = p.revisions + 1
      set p.last_editor = actor
      create Revision { page: p, number: p.revisions, title: good.title, body: good.body, summary: "Undid the edits of " + user.name, author: actor }
    } else if p.key != "main page" {
      delete p
    }
  }
}

// Sets the other names a page is found by (comma-separated): links and addresses with any of them
// show the page. A name can't be another page's title or name.
action set_page_names(page: Page with .wiki, names: Text?) {
  require can_change(actor, page) else forbidden
  delete PageName where .page == page
  if present(names) {
    for each n in split(names, ",") {
      if present(trim(n)) {
        require valid_title(trim(n)) else invalid "a name without [ ] or |"
        require page_named(page.wiki, n) == none else invalid "another page has that title or name"
        ensure PageName { page: page, wiki: page.wiki, name: trim(n), key: lower(trim(n)) }
      }
    }
  }
  touch page
}

// ---------------------------------------------------------------- watching and talk

// Watches a page: its changes and talk show on the watchlist.
action watch_page(page: Page with .wiki) {
  require actor != none else unauthenticated
  ensure Watch { user: actor, page: page, wiki: page.wiki }
}

// Stops watching a page.
action unwatch_page(page: Page with .wiki) {
  require actor != none else unauthenticated
  for each x in Watch where .user == actor and .page == page { delete x }
}

// Marks everything on the watchlist as seen: only what comes after is new.
action mark_watchlist_seen() {
  require actor != none else unauthenticated
  let me = the(User where it == actor)
  set me.watch_seen = now
  set me.watch_unseen = 0
}

// Posts a comment on a page's talk, and watches the page. Anyone who may edit the wiki.
action post_comment(page: Page with .wiki, body: Text) {
  rate_limit 10 per Duration.minutes(10) by actor.email else blocked
  require actor != none else unauthenticated
  require can_edit(actor, page.wiki) else forbidden
  require present(body) else invalid "something to say"
  create Comment { page: page, wiki: page.wiki, author: actor, body: trim(body) } as c
  ensure Watch { user: actor, page: page, wiki: page.wiki }
  result c
}

// Deletes a comment. Its author or a wiki administrator.
action delete_comment(c: Comment with .wiki) {
  require wiki_admin(actor, c.wiki) or (c.author == actor and actor != none) else forbidden
  delete c
}

// Deletes a page and its history. Wiki administrators.
action delete_page(page: Page with .wiki) {
  require wiki_admin(actor, page.wiki) else forbidden
  require page.key != "main page" else invalid "the main page stays"
  delete page
}

// ---------------------------------------------------------------- infoboxes

// Makes an infobox template, a kind of page with its own facts (Weapon, Boss). Wiki administrators.
action create_template(wiki: Wiki, name: Text) {
  require wiki_admin(actor, wiki) else forbidden
  require present(name) else invalid
  require not exists(InfoboxTemplate where .wiki == wiki and .key == lower(trim(name))) else invalid "there is a template with that name"
  create InfoboxTemplate { wiki: wiki, name: trim(name), key: lower(trim(name)) } as t
  result t
}

// Adds a fact to a template, shown in order (Damage, Weight).
action add_template_field(template: InfoboxTemplate with .wiki, label: Text) {
  require wiki_admin(actor, template.wiki) else forbidden
  require present(label) else invalid
  create InfoboxField { template: template, label: trim(label), position: count(InfoboxField where .template == template) + 1 }
}

// Takes a fact off a template, and its values off the pages using it.
action remove_template_field(field: InfoboxField with .template, .template.wiki) {
  require wiki_admin(actor, field.template.wiki) else forbidden
  delete field
}

// Deletes an infobox template; pages using it keep their text.
action delete_template(template: InfoboxTemplate with .wiki) {
  require wiki_admin(actor, template.wiki) else forbidden
  delete template
}

// Gives a page an infobox from one of its wiki's templates, or none.
action set_infobox(page: Page with .wiki, template: InfoboxTemplate? with .wiki) {
  rate_limit 30 per Duration.minutes(10) by actor.email else blocked
  require template == none or template.wiki == page.wiki else invalid
  set page.infobox = template
  set page.revisions = page.revisions + 1
  set page.last_editor = actor
  create Revision { page: page, number: page.revisions, title: page.title, body: page.body, summary: if template != none { "Used the " + template.name + " infobox" } else { "Took the infobox off" }, author: actor }
}

// Sets one fact in a page's infobox; empty clears it.
action set_infobox_value(page: Page with .wiki, field: InfoboxField with .template, .template.wiki, value: Text?) {
  rate_limit 30 per Duration.minutes(10) by actor.email else blocked
  require can_edit(actor, page.wiki) else forbidden
  require page.infobox == field.template else invalid
  if present(value) {
    ensure InfoboxValue { page: page, field: field, value: trim(value) } as v
    set v.value = trim(value)
  } else {
    delete InfoboxValue where .page == page and .field == field
  }
  set page.revisions = page.revisions + 1
  set page.last_editor = actor
  create Revision { page: page, number: page.revisions, title: page.title, body: page.body, summary: if present(value) { "Set " + field.label } else { "Cleared " + field.label }, author: actor }
}

// A page whose title changes keeps its old one as another name, so links to it keep working, and
// the new title is no longer one of its other names. However it's renamed: an edit, a restore, an
// undo, the admin section.
on update Page.key as p when old.key != p.key {
  ensure PageName { page: p, wiki: p.wiki, name: old.title, key: old.key }
  delete PageName where .page == p and .key == p.key
}

// A change or a comment on a watched page is one more new thing for each of its watchers, but its
// author. (Written as they come, so the top bar reads one number.)
on create Revision as r {
  for each x in Watch where .page == r.page and .user != r.author {
    let u = the(User where it == x.user)
    set u.watch_unseen = u.watch_unseen.default(0) + 1
  }
}
on create Comment as c {
  for each x in Watch where .page == c.page and .user != c.author {
    let u = the(User where it == x.user)
    set u.watch_unseen = u.watch_unseen.default(0) + 1
  }
}

// Every revision keeps the page's infobox as it is now, so its history shows infobox changes and
// restoring a revision (or undoing someone's edits) puts the infobox back too.
on create Revision as r {
  let p = the(Page where it == r.page)
  set r.infobox_kept = true
  set r.infobox = p.infobox
  set r.image = p.image
  for each v in InfoboxValue where .page == p with .field {
    create RevisionFact { revision: r, field: v.field, label: v.field.label, value: v.value }
  }
}

// ---------------------------------------------------------------- images

// Uploads an image to a wiki (PNG, JPEG, GIF or WebP, 10 MB at most); pages show it with its Markdown line.
// Uploads an image to a wiki (PNG, JPEG, GIF or WebP, 10 MB at most), called by its name in pages
// ([[File:Name.png]]); the file's own name when none is given.
action upload_image(wiki: Wiki, file: File, caption: Text?, name: Text?) {
  require actor != none else unauthenticated
  require can_edit(actor, wiki) else forbidden
  require file.kind == "image" else invalid "an image: PNG, JPEG, GIF or WebP"
  require file.size <= 10485760 else invalid "an image of 10 MB or less"
  let n = if present(name) { trim(name) } else { file.filename }
  require valid_title(n) else invalid "a name without [ ] or |"
  require image_named(wiki, n) == none else invalid "an image with that name exists"
  create Upload { wiki: wiki, file: file, name: n, caption: if present(caption) { caption } else { none }, uploader: actor } as u
  result u
}

// Renames an uploaded image. Pages that call it by its old name show it no longer: change them too.
// Its uploader or a wiki administrator, as for deleting it.
action rename_image(upload: Upload with .wiki, name: Text) {
  require wiki_admin(actor, upload.wiki) or upload.uploader == actor else forbidden "its uploader or a wiki administrator"
  require valid_title(trim(name)) else invalid "a name without [ ] or |"
  require image_named(upload.wiki, name) == none or image_named(upload.wiki, name) == upload else invalid "an image with that name exists"
  set upload.name = trim(name)
}

// Replaces an uploaded image's file, keeping its name: every page that shows it shows the new one.
// Its uploader or a wiki administrator, as for deleting it.
action replace_image(upload: Upload with .wiki, file: File) {
  require wiki_admin(actor, upload.wiki) or upload.uploader == actor else forbidden "its uploader or a wiki administrator"
  require file.kind == "image" else invalid "an image: PNG, JPEG, GIF or WebP"
  require file.size <= 10485760 else invalid "an image of 10 MB or less"
  set upload.file = file
}

// Deletes an uploaded image. Its uploader or a wiki administrator.
action delete_image(upload: Upload with .wiki) {
  skip policy upload_writes
  require wiki_admin(actor, upload.wiki) or (upload.uploader == actor and can_edit(actor, upload.wiki)) else forbidden
  delete upload
}

// ---------------------------------------------------------------- the site

// Changes the install's settings: its name, base domain, sign-ups, who may start wikis, ads. Site administrators.
action update_site(name: Text, tagline: Text?, base_domain: Text?, open_signups: Bool, anyone_can_create_wikis: Bool, ads_enabled: Bool, wiki_admins_can_turn_off_ads: Bool, agents_enabled: Bool?, agents_read_without_token: Bool?) {
  require site_admin(actor) else forbidden
  require present(name) else invalid
  set Site.name = name
  set Site.tagline = if present(tagline) { tagline } else { none }
  set Site.base_domain = if present(base_domain) { lower(trim(base_domain)) } else { none }
  set Site.open_signups = open_signups
  set Site.anyone_can_create_wikis = anyone_can_create_wikis
  set Site.ads_enabled = ads_enabled
  set Site.wiki_admins_can_turn_off_ads = wiki_admins_can_turn_off_ads
  if agents_enabled != none { set Site.agents_enabled = agents_enabled }
  if agents_read_without_token != none { set Site.agents_read_without_token = agents_read_without_token }
}

// Adds an ad: a house ad (image and link), an AdSense unit, or a network's code. Site administrators.
action create_ad(label: Text, placement: AdPlacement, kind: AdKind, image: File?, link: Url?, alt: Text?, network_client: Text?, network_unit: Text?, code: Text?) {
  require site_admin(actor) else forbidden
  require kind != house or (image != none and link != none) else invalid "a house ad needs an image and a link"
  require kind != network or (present(network_client) and present(network_unit)) else invalid "an AdSense unit needs its client (ca-pub-…) and slot id"
  require kind != code or present(code) else invalid "paste the network's ad code"
  require image == none or image.kind == "image" else invalid "an image"
  create AdSlot { label: label, placement: placement, kind: kind, image: image, link: link, alt: if present(alt) { alt } else { none },
    network_client: if present(network_client) { trim(network_client) } else { none }, network_unit: if present(network_unit) { trim(network_unit) } else { none },
    code: if present(code) { code } else { none } } as a
  result a
}

// Pauses an ad or shows it again.
action set_ad_active(ad: AdSlot, active: Bool) {
  require site_admin(actor) else forbidden
  set ad.active = active
}

// Deletes an ad.
action delete_ad(ad: AdSlot) {
  require site_admin(actor) else forbidden
  delete ad
}

// ---------------------------------------------------------------- views

// The public wikis, by name.
view public_wikis() {
  rows Wiki where .visibility == public
  order by lower(.name)
}

// The wikis you are a member of.
view my_wikis() {
  rows Membership where .user == actor
  order by lower(.wiki.name)
  with .wiki
}

// A wiki's latest revisions, newest first.
view recent_changes(wiki: Wiki) {
  require can_read(actor, wiki) else not_found
  rows Revision where .page.wiki == wiki
  order by created desc
  limit 30
  with .page, .author
}

// Every page of a wiki, by title.
view all_pages(wiki: Wiki) {
  require can_read(actor, wiki) else not_found
  rows Page where .wiki == wiki
  order by .key
}

// A wiki's pages whose title or text has the words searched for.
view search_pages(wiki: Wiki, q: Text) {
  require can_read(actor, wiki) else not_found
  rows Page where .wiki == wiki and (matches(.title, q) or matches(.body, q) or .id in list(.page.id for PageName where .wiki == wiki and matches(.name, q)))
  order by .key
  limit 50
}

// A page's revisions, newest first.
view page_history(page: Page with .wiki) {
  rows Revision where .page == page
  order by .number desc
  with .author
}

// The changes to the pages you watch, newest first, on the wikis you can still read.
view watched_changes() {
  require actor != none else unauthenticated
  rows Revision where .page.id in list(.page.id for Watch where .user == actor)
  order by created desc
  limit 50
  with .page, .page.wiki, .author
}

// The talk on the pages you watch, newest first.
view watched_talk() {
  require actor != none else unauthenticated
  rows Comment where .page.id in list(.page.id for Watch where .user == actor)
  order by created desc
  limit 30
  with .page, .page.wiki, .author
}

// The pages you watch, by title.
view my_watches() {
  require actor != none else unauthenticated
  rows Watch where .user == actor
  order by .page.key
  limit 500
  with .page, .page.wiki
}

// A page's talk, oldest first.
view talk_of(page: Page with .wiki) {
  rows Comment where .page == page
  order by created
  limit 500
  with .author
}

// how many changes and comments on the pages someone watches came since they last looked, not
// their own: counted as each comes (below), so reading it is one field, on every page they see
fn watch_news(u: User?): Int = if u != none { u.watch_unseen.default(0) } else { 0 }

// A page's subpages (Damage/Cost under Damage), by title.
view subpages(page: Page with .wiki) {
  rows Page where .wiki == page.wiki and starts_with(.key, page.key + "/")
  order by .key
  limit 100
}

// The pages that show this one as a snippet (its title in double braces), by title.
view used_on(page: Page with .wiki) {
  rows Page where .wiki == page.wiki and (contains(lower(.body), "\{\{" + page.key + "\}\}") or contains(lower(.body), "\{\{" + page.key + "|"))
  order by .key
  limit 100
}

// The other names a page is found by.
view names_of(page: Page with .wiki) {
  rows PageName where .page == page
  order by .key
}

// The categories a page is in.
view categories_of(page: Page with .wiki) {
  rows PageCategory where .page == page
  order by .key
}

// The pages in one category.
view category_pages(wiki: Wiki, key: Text) {
  require can_read(actor, wiki) else not_found
  rows PageCategory where .wiki == wiki and .key == lower(key)
  order by .page.key
  with .page
}

// A wiki's members and their roles.
view wiki_members(wiki: Wiki) {
  require can_read(actor, wiki) else not_found
  rows Membership where .wiki == wiki
  order by lower(.user.name)
  with .user
}

// A wiki's uploaded images, newest first.
view wiki_uploads(wiki: Wiki) {
  require can_read(actor, wiki) else not_found
  rows Upload where .wiki == wiki
  order by created desc
  with .uploader
}

// The pages that use an infobox template, by title: the rows of its table.
view template_pages(template: InfoboxTemplate with .wiki) {
  rows Page where .infobox == template
  order by .key
  limit 1000
}

// A wiki's infobox templates.
view wiki_templates(wiki: Wiki) {
  require can_read(actor, wiki) else not_found
  rows InfoboxTemplate where .wiki == wiki
  order by .key
}

// A template's facts, in order.
view template_fields(template: InfoboxTemplate with .wiki) {
  rows InfoboxField where .template == template
  order by .position
}

// The active ads for one place on the page.
view ads_at(placement: AdPlacement) {
  rows AdSlot where .placement == placement and .active
  order by created
}

// Every ad, for site administrators.
view all_ads() {
  require site_admin(actor) else forbidden
  rows AdSlot
  order by created desc
}

extern fn line_diff(old: Text, new: Text): list of Text effect pure = go LineDiff
extern fn excerpt(text: Text, n: Int): Text effect pure = go Excerpt
