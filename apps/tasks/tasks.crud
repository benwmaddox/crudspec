// A small team task tracker in crudspec: a second app on the same language and runtime as
// Campfire, sharing no code with it. Projects have members; members see and edit a project's
// tasks; finishing a task stamps who finished it and when.

enum TaskStatus { open, doing, done }

entity Person {
  name: Text
  email: Email
  password: Password
  unique (email)
}

entity Login {
  person: Person on delete cascade
  token: Text = token(24)
  unique (token)
}

entity Project {
  name: Text
  owner: Person
}

entity Membership {
  project: Project on delete cascade
  person: Person on delete cascade
  unique (project, person)
}

entity Task {
  project: Project on delete cascade on change touch
  title: Text
  notes: Text?
  status: TaskStatus = open
  assignee: Person?
  finished_by: Person?
  finished_at: Time?
  invariant (self.status == done) == (self.finished_at != none)   // a finished task records when
}

entity Comment {
  task: Task on delete cascade on change touch
  author: Person on delete cascade
  body: Text
}

app tasks {
  name "Tasks"
  actor Person
  sign_in_screen sign_in_screen
  setup_screen sign_up_screen
  setup_when not exists(Person)
}

show Person {
  label: .name
  picture: initials(.name)
}

theme tasks {
  stylesheets ["tasks.css"]
  classes { button: "btn", submit: "btn", screen_reader: "for-screen-reader", form: "form", avatar: "avatar", generated_section: "card", input: "input" }
  tokens json { ink: "#1f2328", muted: "#6a737d", line: "#e1e4e8", accent: "#2f6feb", bg: "#f6f8fa" }
}

identity login: Login.token from cookie "login"
// agents act for a person, with that person's access
identity agent: Person from token

policy signed_in: actor != none else unauthenticated for every action

fn member(p: Person, pr: Project): Bool = exists(Membership where .project == pr and .person == p)

policy project_rows: member(actor, project) for rows of Project
policy task_rows: member(actor, task.project) for rows of Task
policy comment_rows: member(actor, comment.task.project) for rows of Comment
policy membership_rows: member(actor, membership.project) for rows of Membership
policy person_rows: true for rows of Person

// ---- people

// Makes an account and signs it in.
action sign_up(name: Text, email: Email, password: Text)
{
  callers people                          // a browser session: agents have tokens
  skip policy signed_in
  rate_limit 10 per 3 min by request.ip else blocked
  require not exists(Person where .email == email) else invalid
  create Person { name: name, email: email, password: password } as p
  create Login { person: p } as l
  result l
}

// Signs a person in with their email address and password.
action sign_in(email: Email, password: Text)
{
  callers people
  skip policy signed_in
  rate_limit 10 per 3 min by request.ip else blocked
  let p = the_or_none(Person where .email == email)
  require p != none and authenticates(p.password, password) else unauthenticated
  create Login { person: p } as l
  result l
}

// Signs out of this browser.
action sign_out() {
  callers people
  delete Login where .token == request.session_token
}

// ---- projects

// Creates a project you own and are a member of.
action create_project(name: Text) {
  require present(name) else invalid
  create Project { name: name, owner: actor } as pr
  create Membership { project: pr, person: actor }
  result pr
}

// Adds the person with this email address to a project you own.
action add_member(project: Project, email: Email) {
  require member(actor, project) else not_found
  require project.owner == actor else forbidden
  let p = the_or_none(Person where .email == email)
  require p != none else invalid
  ensure Membership { project: project, person: p }
}

// Takes you out of a project (its owner can't leave it).
action leave_project(project: Project) {
  require member(actor, project) else not_found
  require project.owner != actor else forbidden            // the owner stays
  delete Membership where .project == project and .person == actor
}

// ---- tasks

// Adds a task to a project you're in, optionally assigned to a member.
action add_task(project: Project, title: Text, assignee: Person?) {
  require member(actor, project) else not_found
  require present(title) else invalid
  require assignee == none or member(assignee, project) else invalid
  create Task { project: project, title: title, assignee: assignee } as t
  result t
}

// Moves a task to open, in progress or done; done records when.
action set_status(task: Task, status: TaskStatus) {
  require member(actor, task.project) else not_found
  set task.status = status
}

// Finishing a task stamps who and when; reopening clears it (the invariant holds either way).
trigger on update Task.status as t when t.status == done {
  set t.finished_by = actor
  set t.finished_at = now
}
trigger on update Task.status as t when t.status != done and old.status == done {
  set t.finished_by = none
  set t.finished_at = none
}

// Assigns a task to one of its project's members, or to no one.
action assign(task: Task, assignee: Person?) {
  require member(actor, task.project) else not_found
  require assignee == none or member(assignee, task.project) else invalid
  set task.assignee = assignee
}

// Deletes a task. The project's owner only.
action delete_task(task: Task) {
  require member(actor, task.project) else not_found
  require task.project.owner == actor else forbidden
  delete task
}

// Sets a task's notes; empty clears them.
action edit_notes(task: Task, notes: Text?) {
  require member(actor, task.project) else not_found
  set task.notes = if present(notes) { notes } else { none }
}

// Adds a comment to a task.
action comment(task: Task, body: Text) {
  require member(actor, task.project) else not_found
  require present(body) else invalid
  create Comment { task: task, author: actor, body: body }
}

// ---- views

// The projects you're a member of.
view my_projects() {
  updates live
  rows Project where member(actor, it)
  order by lower(.name)
}

// A project's tasks.
view project_tasks(project: Project) {
  updates live
  require member(actor, project) else not_found
  rows Task where .project == project
  order by created
}

// A project's members.
view project_members(project: Project) {
  require member(actor, project) else not_found
  rows Membership where .project == project
}

// A task's comments, oldest first.
view task_comments(task: Task) {
  updates live
  require member(actor, task.project) else not_found
  rows Comment where .task == task
  order by created
}

// A project's members whose name contains what's typed: who a task can be assigned to.
view members_to_assign(project: Project, typed: Text?) {
  rows Person where member(it, project) and (typed == none or contains(lower(.name), lower(typed)))
  order by lower(.name)
}

// ---- UI

layout app {
  <Title />
  <nav>
    <Slot name=nav />
  </nav>
  <Flash />
  <main>
    <Slot name=main />
    <footer>
      <Slot name=footer />
    </footer>
  </main>
}

screen sign_up_screen {
  route "/sign-up"
  layout app
  access public
  <Title>Create your account</Title>
  <Fill name=main>
    <section class="card">
      <h1>Create your account</h1>
      <Form action={sign_up}>
        <Field name=name kind=text placeholder="Name" required />
        <Field name=email kind=email placeholder="Email" required />
        <Field name=password kind=password placeholder="Password" required />
        <Submit label="Sign up" />
        <On ok go={home} />
        <On invalid flash="That email is already registered." />
      </Form>
      <Link to={sign_in_screen()} class="quiet">
        <span>I have an account</span>
      </Link>
    </section>
  </Fill>
}

screen sign_in_screen {
  route "/sign-in"
  layout app
  access public
  <Title>Sign in</Title>
  <Fill name=main>
    <section class="card">
      <h1>Sign in</h1>
      <Form action={sign_in}>
        <Field name=email kind=email placeholder="Email" required />
        <Field name=password kind=password placeholder="Password" required />
        <Submit label="Sign in" />
        <On ok go={home} />
        <On unauthenticated flash="Wrong email or password." />
      </Form>
      <Link to={sign_up_screen()} class="quiet">
        <span>Create an account</span>
      </Link>
    </section>
  </Fill>
}

screen home {
  route "/"
  layout app
  <Title>Projects</Title>
  <Fill name=nav>
    <TopBar />
  </Fill>
  <Fill name=main>
    <section class="card">
      <h1>Your projects</h1>
      <List of={my_projects()} as=pr class="list">
        <Link to={project_screen(pr)} class="row">
          <strong>{pr.name}</strong>
          <span class="muted">{count(Task where .project == pr and .status != done) + " open"}</span>
        </Link>
      </List>
      <Form action={create_project} class="inline">
        <Field name=name kind=text placeholder="New project" required />
        <Submit label="Create" />
        <On ok go={project_screen(result)} />
      </Form>
    </section>
  </Fill>
}

component TopBar() {
  <div class="bar">
    <Link to={home} class="brand">
      <span>Tasks</span>
    </Link>
    <div class="who">
      <Avatar>{actor}</Avatar>
      <span>{actor.name}</span>
      <Link href="/_agents" label="Agents" class="quiet" />
      <Button action={sign_out()} label="Sign out" class="quiet" />
      <On ok go={sign_in_screen()} />
    </div>
  </div>
}

screen project_screen(project: Project) {
  route "/projects/:project"
  layout app
  require member(actor, project) else go home flash "Project not found."
  <Title>{project.name}</Title>
  <Fill name=nav>
    <TopBar />
  </Fill>
  <Fill name=main>
    <section class="card">
      <h1>{project.name}</h1>
      <List of={project_tasks(project)} as=t where={t.status != done} class="list">
        <TaskRow t={t} />
      </List>
      <Form action={add_task(project)} class="inline">
        <Field name=title kind=text placeholder="Add a task" required />
        <Submit label="Add" />
        <On ok stay />
      </Form>
      <h1>Done</h1>
      <List of={project_tasks(project)} as=t where={t.status == done} order={t.finished_at} desc class="list done">
        <TaskRow t={t} />
      </List>
    </section>
    <section class="card">
      <h1>Members</h1>
      <List of={project_members(project)} as=m class="list">
        <div class="row">
          <Avatar>{m.person}</Avatar>
          <span>{m.person.name}</span>
        </div>
      </List>
      {if project.owner == actor {
        <Form action={add_member(project)} class="inline">
          <Field name=email kind=email placeholder="Add someone by email" required />
          <Submit label="Add" />
          <On ok stay flash="Added." />
          <On invalid flash="No one with that email." />
        </Form>
      } else {
        <Button action={leave_project(project)} label="Leave project" class="quiet" confirm="Leave this project?" />
        <On ok go={home} />
      }}
    </section>
  </Fill>
}

component TaskRow(t: Task) {
  <div class={"row task " + text(t.status)}>
    {if t.status == done {
      <Button action={set_status(t, open)} text="↺" label="Reopen" class="check" />
    } else {
      <Button action={set_status(t, done)} text="✓" label="Finish" class="check" />
    }}
    <Link to={task_screen(t)} class="title">
      <span>{t.title}</span>
    </Link>
    {if t.assignee != none {
      <Avatar>{t.assignee}</Avatar>
    }}
    {if t.status == done {
      <span class="muted">{"done by " + t.finished_by.name}</span>
    } else if t.status == open {
      <Button action={set_status(t, doing)} text="start" class="quiet" />
    }}
  </div>
}

screen task_screen(task: Task) {
  route "/tasks/:task"
  layout app
  require member(actor, task.project) else go home flash "Task not found."
  <Title>{task.title}</Title>
  <Fill name=nav>
    <TopBar />
  </Fill>
  <Fill name=main>
    <section class="card">
      <Link to={project_screen(task.project)} class="quiet">
        <span>{"← " + task.project.name}</span>
      </Link>
      <h1>{task.title}</h1>
      <div class="row">
        <span>{"Status: " + text(task.status)}</span>
        {if task.finished_at != none {
          <Time as={time}>{task.finished_at}</Time>
        }}
      </div>
      <Form action={edit_notes(task)}>
        <Field name=notes kind=textarea label="Notes" value={task.notes} />
        <Submit label="Save notes" />
        <On ok stay />
      </Form>
      <Form action={assign(task)} class="inline">
        <Field name=assignee kind=select from={list(.person for Membership where .project == task.project)} value={task.assignee} />
        <Submit label="Assign" />
        <On ok stay />
      </Form>
      {if task.project.owner == actor {
        <Button action={delete_task(task)} label="Delete task" class="quiet" confirm="Delete this task?" />
        <On ok go={project_screen(task.project)} />
      }}
    </section>
    <section class="card">
      <h1>Comments</h1>
      <List of={task_comments(task)} as=c class="list">
        <div class="row">
          <Avatar>{c.author}</Avatar>
          <strong>{c.author.name}</strong>
          <span>{c.body}</span>
        </div>
      </List>
      <Form action={comment(task)} class="inline">
        <Field name=body kind=text placeholder="Write a comment" required />
        <Submit label="Comment" />
        <On ok stay />
      </Form>
    </section>
  </Fill>
}
