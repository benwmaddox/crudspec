// TodoMVC (todomvc.com/app-spec) in crudspec, rendered on the server: every change is a form
// post, every view a page, and the list lives in the database. Each browser has its own list, as
// with the reference implementations' local storage: its first todo makes the list, and a
// cookie keeps it. The only script is the runtime's behaviors: double-click to edit, Escape to
// cancel.

entity Board {
  token: Text = token(24)
  unique (token)
}

entity Todo {
  board: Board on delete cascade on change touch
  title: Text max 1000
  completed: Bool = false
}

// no todo has a blank title: adding needs one, and an edit that blanks it removes the todo
invariant titles_not_blank: all(.title.present() for Todo where true)

app todomvc {
  name "TodoMVC"
  about "A to-do list: add todos, mark them complete, rename, delete, and clear the completed ones"
  actor Board
}

identity visitor: Board.token from cookie "todos"
// agents act on a list: its browser issues them a token at /_agents
identity agent: Board from token

theme todomvc {
  stylesheets ["todomvc.css"]
  classes { button: "", submit: "", screen_reader: "visually-hidden", form: "" }
}

policy todo_rows: .board == actor for rows of Todo

// which todos the list shows (all, when the address doesn't say)
enum Filter { all, active, completed }

fn is_mine(t: Todo): Bool = t.board == actor
query items_left(b: Board?): Int = count(Todo where .board == b and not .completed)
query todo_count(b: Board?): Int = count(Todo where .board == b)
fn shows(show: Filter?, link: Filter): Bool = show.default(all) == link

// ---- actions (app-spec: "New todo", "Mark all as complete", "Item", "Editing", "Clear completed")

// The first todo makes this browser's list; the screen signs the browser in to it.
action add_todo(title: Text) {
  callers people
  let new_title = title.trim()
  require new_title.present() else invalid
  if actor == none {
    create Board { } as b
    create Todo { board: b, title: new_title }
    result b
  } else {
    create Todo { board: actor, title: new_title }
  }
}

// adds a todo to the end of the list
action add(title: Text) {
  callers api
  require actor != none else unauthenticated
  let new_title = title.trim()
  require new_title.present() else invalid
  create Todo { board: actor, title: new_title }
}

// marks a todo complete, or active again when it is
action toggle(t: Todo) {
  require t.is_mine() else not_found
  set t.completed = not t.completed
}

// all complete, or, when all already are, all active again
action toggle_all() {
  require actor != none else not_found
  let all_done = actor.items_left() == 0
  for each t in Todo where .board == actor { set t.completed = not all_done }
}

// an edit that leaves the title empty removes the todo
action rename(t: Todo, title: Text) {
  require t.is_mine() else not_found
  let new_title = title.trim()
  if new_title.blank() { delete t } else { set t.title = new_title }
}

// deletes a todo
action destroy(t: Todo) {
  require t.is_mine() else not_found
  delete t
}

// deletes every completed todo
action clear_completed() {
  delete Todo where .board == actor and .completed
}

// the list's todos, oldest first: all of them, or only the active or the completed ones
view todos(show: Filter?) {
  updates live
  rows Todo where .board == actor and (show != active or not .completed) and (show != completed or .completed)
  order by created
}

// ---- UI

layout page {
  <Title />
  <main>
    <Slot name=main />
  </main>
  <footer>
    <Slot name=footer />
  </footer>
}

// editing: the todo being edited
screen home(show: Filter?, editing: Todo?) {
  route "/"
  layout page
  require public
  <Title>crudspec • TodoMVC</Title>
  <Fill name=main>
    <section class="todoapp">
      <section class="header">
        <h1>todos</h1>
        <Form action={add_todo}>
          <Field name=title kind=text class="new-todo" placeholder="What needs to be done?" />
          <On ok sign_in={result} clear_form />
          <On invalid stay />
        </Form>
      </section>
      {let left = actor.items_left()}
      {let total = actor.todo_count()}
      {if total > 0 {
        <section class="main">
          <Button action={toggle_all()} class="toggle-all" label="Mark all as complete" selected={left == 0} />
          <List of={todos(show)} as=t class="todo-list">
            <TodoItem t={t} show={show} editing={editing} />
          </List>
        </section>
        <section class="footer">
          <span class="todo-count">{left} {if left == 1 { item } else { items }} left</span>
          <div class="filters">
            <Link to={home()} class={when(show.shows(all), "selected")}><span>All</span></Link>
            <Link to={home(active)} class={when(show.shows(active), "selected")}><span>Active</span></Link>
            <Link to={home(completed)} class={when(show.shows(completed), "selected")}><span>Completed</span></Link>
          </div>
          {if total > left {
            <Button action={clear_completed()} class="clear-completed" label="Clear completed" />
          }}
        </section>
      }}
    </section>
  </Fill>
  <Fill name=footer>
    <section class="info">
      <span>Double-click to edit a todo</span>
      <span>Part of TodoMVC, in crudspec</span>
      <span><Link href="/_agents" label="Agent access" /></span>
    </section>
  </Fill>
}

component TodoItem(t: Todo, show: Filter?, editing: Todo?) {
  <div class={["todo", when(t.completed, "completed"), when(editing == t, "editing")]}>
    {if editing == t {
      <Form action={rename(t)} auto_submit>
        // focused at the end of its text as it opens; Escape cancels; leaving it unchanged ends
        // the edit (a changed one is saved: the form submits on change)
        <Field name=title kind=text class="edit" value={t.title} cs:ref=edit cs:shown={focus(edit)}
               cs:key_escape={go(url_of(home(show)))} cs:blur_unchanged={go(url_of(home(show)))} />
        <On ok go={home(show)} />
      </Form>
    } else {
      <div class="view">
        <Button action={toggle(t)} class="toggle" label={if t.completed { "Mark as active" } else { "Mark as complete" }} selected={t.completed} />
        // double-click (or Enter) opens it for editing
        <label tabindex="0" cs:dblclick={go(url_of(home(show, t)))} cs:key_enter={go(url_of(home(show, t)))}>{t.title}</label>
        <Button action={destroy(t)} class="destroy" label="Delete" />
      </div>
    }}
  </div>
}
