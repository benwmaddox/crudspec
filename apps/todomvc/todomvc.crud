// TodoMVC (todomvc.com/app-spec) in crudspec, rendered on the server: every change is a form
// post, every view a page, and the list lives in the database. Each browser has its own list, as
// with the reference implementations' local storage: its first todo makes the list, and a
// cookie keeps it. The only script is widgets.go's: double-click to edit, Escape to cancel.

entity Board {
  token: Text = token(24)
  unique (token)
}

entity Todo {
  board: Board on delete cascade on change touch
  title: Text max 1000
  completed: Bool = false
}

app todomvc {
  name "TodoMVC"
  actor Board
}

identity visitor: Board.token from cookie "todos"

theme todomvc {
  stylesheets ["todomvc.css"]
  classes { button: "", submit: "", screen_reader: "visually-hidden", form: "" }
}

policy todo_rows: todo.board == actor for rows of Todo

fn mine(t: Todo): Bool = t.board == actor and actor != none

// ---- actions (app-spec: "New todo", "Mark all as complete", "Item", "Editing", "Clear completed")

// The first todo makes this browser's list; the screen signs the browser in to it.
action add_todo(title: Text) {
  require present(trim(title)) else invalid
  if actor == none {
    create Board { } as b
    create Todo { board: b, title: trim(title) }
    result b
  } else {
    create Todo { board: actor, title: trim(title) }
  }
}

action toggle(t: Todo) {
  require mine(t) else not_found
  set t.completed = not t.completed
}

// all complete, or, when all already are, all active again
action toggle_all() {
  require actor != none else not_found
  let done = not exists(Todo where .board == actor and not .completed)
  for each t in Todo where .board == actor { set t.completed = not done }
}

// an edit that leaves the title empty removes the todo
action rename(t: Todo, title: Text) {
  require mine(t) else not_found
  if blank(trim(title)) { delete t } else { set t.title = trim(title) }
}

action destroy(t: Todo) {
  require mine(t) else not_found
  delete t
}

action clear_completed() {
  delete Todo where .board == actor and .completed
}

view todos() {
  updates live
  rows Todo where .board == actor
  order by created
}

// ---- UI

widget edit_on_double_click(title: Text, href: Url)
widget edit_keys(cancel: Url)

layout page {
  <Title />
  <Main>
    <Slot name=main />
  </Main>
  <Footer>
    <Slot name=footer />
  </Footer>
}

// which todos the list shows (all, when the address doesn't say)
enum Filter { all, active, completed }

// editing: the todo being edited
screen home(show: Filter?, editing: Todo?) {
  route "/"
  layout page
  access public
  <Title>crudspec • TodoMVC</Title>
  <Main>
    <section class="todoapp">
      <section class="header">
        <h1>todos</h1>
        <Form action={add_todo}>
          <Field name=title kind=text class="new-todo" placeholder="What needs to be done?" />
          <On ok sign_in={result} clear_form />
          <On invalid stay />
        </Form>
      </section>
      {let left = count(Todo where .board == actor and not .completed)}
      {let total = count(Todo where .board == actor)}
      {if total > 0 {
        <section class="main">
          <Button action={toggle_all()} class="toggle-all" label="Mark all as complete" selected={left == 0} />
          <List of={todos()} as=t where={match show { active { not t.completed } completed { t.completed } all, none { true } }} class="todo-list">
            <TodoItem t={t} show={show} editing={editing} />
          </List>
        </section>
        <section class="footer">
          <Text class="todo-count">{left} {if left == 1 { "item" } else { "items" }} left</Text>
          <div class="filters">
            <Link to={home()} class={match show { all, none { "selected" } active, completed { "" } }}>
              <Text>All</Text>
            </Link>
            <Link to={home(active)} class={if show == active { "selected" } else { "" }}>
              <Text>Active</Text>
            </Link>
            <Link to={home(completed)} class={if show == completed { "selected" } else { "" }}>
              <Text>Completed</Text>
            </Link>
          </div>
          {if total > left {
            <Button action={clear_completed()} class="clear-completed" label="Clear completed" />
          }}
        </section>
      }}
    </section>
  </Main>
  <Footer>
    <section class="info">
      <Text>Double-click to edit a todo</Text>
      <Text>Part of TodoMVC, in crudspec</Text>
    </section>
  </Footer>
}

component TodoItem(t: Todo, show: Filter?, editing: Todo?) {
  <div class={(if t.completed { "todo completed" } else { "todo" }) + (if editing == t { " editing" } else { "" })}>
    {if editing == t {
      <Form action={rename(t)} auto_submit class="edit-form">
        <Field name=title kind=text class="edit" value={t.title} />
        <On ok go={home(show)} />
      </Form>
      <Widget call={edit_keys(url_of(home(show)))} />
    } else {
      <div class="view">
        <Button action={toggle(t)} class="toggle" label={if t.completed { "Mark as active" } else { "Mark as complete" }} selected={t.completed} />
        <Widget call={edit_on_double_click(t.title, url_of(home(show, t)))} />
        <Button action={destroy(t)} class="destroy" label="Delete" />
      </div>
    }}
  </div>
}
