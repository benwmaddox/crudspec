data Reaction {                                                    // emoji_helper.rb: quick boosts
  character: Text
  title: Text
} rows [
  { character: "👍", title: "Thumbs up" },
  { character: "👏", title: "Clapping" },
  { character: "👋", title: "Waving hand" },
  { character: "💪", title: "Muscle" },
  { character: "❤️", title: "Red heart" },
  { character: "😂", title: "Face with tears of joy" },
  { character: "🎉", title: "Party popper" },
  { character: "🔥", title: "Fire" }
]

singleton Account {
  name: Text
  join_code: Text = join(chunks(token(12), 4), "-")              // account/joinable.rb
  logo: File?
  custom_styles: Text?
  restrict_room_creation: Bool = false                             // R2
}

entity User {
  name: Text
  email: Email?
  password: Password? max 72                                       // has_secure_password: 72 at most
  bio: Text?
  avatar: File?
  role: Role = member                                              // P1
  status: UserStatus = active
  bot_token: Text?                                                 // user/bot.rb
  unique (email)
}

entity Session {
  user: User on delete cascade
  token: Text = token(24)
  ip: Ip?
  user_agent: Text? write_only                                     // Rails stores these and shows them nowhere
  last_active: Time write_only = now
  unique (token)
  invariant self.user.status == active                             // A3, D3, N1
}

entity Room {
  type: RoomType
  name: Text?
  creator: User
  invariant self.type == direct implies self.name == none          // R5, R11
}

entity Membership {
  room: Room on delete cascade
  user: User on delete cascade
  involvement: Involvement = if .room.type == direct { everything } else { mentions }   // R6
  unread_since: Time?                                              // U1: unread_at
  connected_at: Time?                                              // U2
  connections: Int = 0
  unique (room, user)                                              // R7
}

entity Message {
  room: Room on delete cascade on change touch                             // message.rb: touch: true
  creator: User on delete cascade
  body: RichText searchable
  attachment: File?
  client_id: Text = token(36)
}

entity Boost {
  message: Message on delete cascade on change touch
  booster: User on delete cascade
  content: Text                                                    // B2: 16 declared, not enforced
}

entity Ban {
  user: User on delete cascade
  ip: Ip
  unique (user, ip)
  invariant public_ip(self.ip)                                     // ban.rb validation
  invariant self.user.status == banned                             // N1, N3
}

entity Search {                                                    // search.rb
  user: User on delete cascade
  query: Text
  unique (user, query)
}

entity PushSubscription {                                          // push/subscription.rb
  user: User on delete cascade
  endpoint: Url private                                          // capability URLs and keys never leave the server
  p256dh_key: Text? private
  auth_key: Text? private
  user_agent: Text?
  invariant push_endpoint_permitted(self.endpoint)
}

entity Webhook {                                                   // webhook.rb
  user: User on delete cascade
  url: Url
  unique (user)
}

// ======================================================================== identity

identity session: Session.token from cookie "session_token"
identity bot_key: User from param bot_key as "{id}-{bot_token}" where .role == bot and .status == active   // path or query, as Rails params
// Agents act for an active person, never for a bot (bots have their own API); deactivating
// someone cuts off their agents too.
identity agent: User from token where .status == active and .role != bot

// Banned addresses are refused before anything else, then visitors must sign in, then
// bots may only use the bot API (concerns/block_banned_requests.rb, authentication.rb).
policy blocked_ip: not (request.method == write and exists(Ban where .ip == request.ip)) else blocked for every action     // A2
policy signed_in: actor != none else unauthenticated for every action                                                 // A1
policy deny_bots: not (request.identity == bot_key) else forbidden for every action

// ======================================================================== rules

fn administrator(u: User): Bool = u.role == administrator
fn can_administer(u: User, creator: User?): Bool = u.role == administrator or u == creator      // P2
// another active administrator than u: the account keeps one (a departure from Rails, which lets
// the last one go; invariant admin_exists)
fn another_admin(u: User): Bool = exists(User where .role == administrator and .status == active and it != u)
fn member(u: User, r: Room): Bool = exists(Membership where .room == r and .user == u)
fn may_create_rooms(u: User): Bool = not Account.restrict_room_creation or u.role == administrator
fn connected(m: Membership): Bool = m.connected_at != none and m.connected_at >= now - 60 s   // U2
fn visible(m: Membership): Bool = m.involvement != invisible
fn unread(m: Membership): Bool = m.unread_since != none
fn same_members(r: Room, users: set of User): Bool =
  all(.user in users for Membership where .room == r) and all(member(it, r) for User where it in users)
fn in_direct_room_with(u: User, me: User): Bool = exists(Membership where .user == u and .room.type == direct and member(me, .room))
fn push_endpoint_permitted(u: Url): Bool =                        // push/subscription.rb
  scheme(u) == "https" and port(u) == 443 and
  host_within(u, ["jmt17.google.com", "fcm.googleapis.com", "updates.push.services.mozilla.com", "web.push.apple.com", "notify.windows.com"])

fn display_name(r: Room, viewer: User?): Text? =                    // rooms_helper.rb
  if r.type == direct
  { (if any(list(.user.name for Membership where .room == r and .user != viewer))
        { sentence(list(.user.name for Membership where .room == r and .user != viewer order by .user.created))
        } else { viewer.name })
  } else { r.name }
fn plain_body(m: Message): Text = if present(plain(m.body)) { plain(m.body) } else { (if m.attachment != none { m.attachment.filename } else { "" }) }
fn sound_of(m: Message): Sound? = the_or_none(Sound where .name == after(plain_body(m), "/play ") and words(plain_body(m)) == 2)
fn mentionees(m: Message): set of User = set(User where it in mentions(m.body) and member(it, m.room))
fn user_title(u: User): Text = if present(u.bio) { u.name + " – " + u.bio } else { u.name }
fn bot_key(u: User): Text = text(u.id) + "-" + u.bot_token
fn join_url(): Url = url_of(join_screen(Account.join_code))
fn original_room(): Room? = first_or_none(Room order by created)

policy message_rows: member(actor, message.room) for rows of Message
policy boost_rows: member(actor, boost.message.room) for rows of Boost
policy membership_rows: membership.user == actor for rows of Membership
policy search_rows: search.user == actor for rows of Search
policy push_subscription_rows: push_subscription.user == actor for rows of PushSubscription
policy user_rows: true for rows of User                                         // anyone signed in can see profiles
policy room_rows: member(actor, room) for rows of Room

// ======================================================================== setup and sessions

// Sets up a new Campfire: the first administrator's account, and the first room.
action first_run(name: Text, email: Email, password: Text, avatar: File?)   // first_run.rb
{
  callers people                                                        // a browser session: agents have tokens
  skip policy signed_in
  if not exists(Account) {                                         // prevent_repeats: a repeat is a no-op
    create Account { name: "Campfire" }
    create User { name: name, email: email, password: password, avatar: avatar, role: administrator } as admin
    create Room { type: open, name: "All Talk", creator: admin } as room
    create Session { user: admin, ip: request.ip, user_agent: request.user_agent } as s
    result s
  }
}

// Signs a person in with their email address and password.
action sign_in(email: Email, password: Text)                       // sessions_controller.rb
{
  callers people                                                        // a browser session: agents have tokens
  skip policy signed_in
  rate_limit 10 per 3 min by request.ip else blocked
  let user = the_or_none(User where .email == email and .status == active)
  require user != none and authenticates(user.password, password) else unauthenticated   // A3
  create Session { user: user, ip: request.ip, user_agent: request.user_agent } as s
  result s
}

// Signs out of this browser session.
action sign_out(push_endpoint: Url?) {
  callers people                                                        // a browser session: agents have tokens
  delete PushSubscription where .user == actor and .endpoint == push_endpoint
  delete Session where .token == request.session_token
}

// Signs in on another device from a session transfer link.
action transfer_session(link: Text)                                // sessions/transfers_controller.rb
{
  callers people                                                        // a browser session: agents have tokens
  skip policy signed_in
  let user = verify(User, link, "transfer")
  require user != none and user.status == active else invalid      // head :bad_request
  create Session { user: user, ip: request.ip, user_agent: request.user_agent } as s
  result s
}

fn transfer_link(u: User): Text = signed(u, "transfer", 4 h)      // user/transferable.rb

// Joins the account with its join code as a new member.
action join(join_code: Text, name: Text, email: Email, password: Text, avatar: File?)   // D1, D2
{
  callers people                                                        // a browser session: agents have tokens
  skip policy signed_in
  require join_code == Account.join_code else not_found
  require not exists(User where .email == email) else unauthenticated   // the screen sends them to sign in
  create User { name: name, email: email, password: password, avatar: avatar } as user
  create Session { user: user, ip: request.ip, user_agent: request.user_agent } as s
  result s
}

trigger on create User as u {                                       // D1: user.rb grant_membership_to_open_rooms (bots too)
  for each r in Room where .type == open {
    ensure Membership { room: r, user: u }
  }
}

// ======================================================================== account

// Renames the account, changes its logo, or limits room creation to administrators. Administrators only.
action update_account(name: Text?, logo: File?, restrict_room_creation: Bool?) {
  require can_administer(actor, none) else forbidden               // accounts_controller.rb
  if name != none { set Account.name = name }
  if logo != none { set Account.logo = logo }
  if restrict_room_creation != none { set Account.restrict_room_creation = restrict_room_creation }
}

// Removes the account's logo. Administrators only.
action delete_logo() {
  require can_administer(actor, none) else forbidden
  set Account.logo = none
}

// Sets the CSS added to every page. Administrators only.
action update_custom_styles(custom_styles: Text?) {
  require can_administer(actor, none) else forbidden
  set Account.custom_styles = custom_styles
}

// Replaces the join code, so old join links stop working. Administrators only.
action reset_join_code() {
  require can_administer(actor, none) else forbidden
  set Account.join_code = join(chunks(token(12), 4), "-")
}

// ======================================================================== users

// Changes your own name, email address, password, bio or avatar; leave out what stays the same.
action update_profile(name: Text?, email: Email?, password: Text?, bio: Text?, avatar: File?) {
  if name != none { set actor.name = name }
  if email != none { set actor.email = email }
  if password != none and present(password) { set actor.password = password }
  if bio != none { set actor.bio = bio }
  if avatar != none { set actor.avatar = avatar }
  result if avatar != none { "It may take up to 30 minutes to change everywhere." } else { "✓" }
}

// Removes your own avatar.
action delete_avatar() { set actor.avatar = none }

// Makes a user an administrator or a member. Administrators only.
action change_role(user: User, role: Text) {                       // accounts/users_controller.rb
  require can_administer(actor, none) else forbidden               // P3
  require user.status == active else not_found                     // P5
  require role == "administrator" or user.role != administrator or another_admin(user) else invalid
  set user.role = if role == "administrator" { administrator } else { member }   // P4
}

// Deactivates a user: they can no longer sign in, and they leave every room but direct ones. Administrators only.
action deactivate_user(user: User) {                               // user.rb deactivate
  require can_administer(actor, none) else forbidden
  require user.status == active else not_found
  require user.role != administrator or another_admin(user) else invalid
  delete Membership where .user == user and .room.type != direct   // D3
  delete PushSubscription where .user == user
  delete Search where .user == user
  delete Session where .user == user
  set user.status = deactivated
  set user.email = deactivated_email(user.email)
  emit Disconnect(user)
}
fn deactivated_email(e: Email?): Email? = if e == none { none } else { replace(e, "@", "-deactivated-" + token(36) + "@") }

// Bans a user and the addresses they signed in from, then removes their messages. Administrators only.
action ban_user(user: User) {                                      // user/bannable.rb
  require can_administer(actor, none) else forbidden
  require user.role != administrator or another_admin(user) else invalid
  for each ip in distinct(list(.ip for Session where .user == user and present(.ip))) {
    create Ban { user: user, ip: ip }                              // N1, N2 via the Ban invariant
  }
  delete Session where .user == user
  set user.status = banned
  emit UserBanned(user)
  emit Disconnect(user)
}

// Lifts a user's ban. Administrators only.
action unban_user(user: User) {                                    // N3
  require can_administer(actor, none) else forbidden
  delete Ban where .user == user
  set user.status = active
}

workflow on UserBanned(u) {                                        // remove_banned_content_job.rb
  step remove_messages: delete Message where .creator == u
}

// ======================================================================== bots

// Adds a bot user with its own key; a webhook URL receives the messages that mention it. Administrators only.
action create_bot(name: Text, avatar: File?, webhook_url: Url?) {  // accounts/bots_controller.rb
  require can_administer(actor, none) else forbidden
  create User { name: name, avatar: avatar, role: bot, bot_token: token(12) } as bot
  if webhook_url != none { create Webhook { user: bot, url: webhook_url } }
}

// Renames a bot or changes its avatar or webhook. Administrators only.
action update_bot(b: User, name: Text?, avatar: File?, webhook_url: Url?) {
  require can_administer(actor, none) else forbidden
  require b.role == bot and b.status == active else not_found
  if name != none { set b.name = name }
  if avatar != none { set b.avatar = avatar }
  if webhook_url != none and present(webhook_url) {
    delete Webhook where .user == b
    create Webhook { user: b, url: webhook_url }
  } else {
    delete Webhook where .user == b
  }
}

// Removes a bot. Administrators only.
action delete_bot(b: User) {
  require can_administer(actor, none) else forbidden
  require b.role == bot and b.status == active else not_found
  delete Membership where .user == b and .room.type != direct
  delete Session where .user == b
  set b.status = deactivated
}

// Gives a bot a new key, so its old key stops working. Administrators only.
action reset_bot_key(b: User) {
  require can_administer(actor, none) else forbidden
  require b.role == bot and b.status == active else not_found
  set b.bot_token = token(12)
}

// ======================================================================== rooms

// Creates a room every user of the account is a member of.
action create_open_room(name: Text) {
  require may_create_rooms(actor) else forbidden                   // R2
  create Room { type: open, name: name, creator: actor } as room
  ensure Membership { room: room, user: actor }                    // R3: creator first
  result room
}

// Creates a closed room whose members are the given active users; include yourself to be in it.
action create_closed_room(name: Text, users: set of User) {
  require may_create_rooms(actor) else forbidden
  create Room { type: closed, name: name, creator: actor } as room
  for each u in User where u in users and .status == active {    // R4; only active people (a departure from Rails)
    ensure Membership { room: room, user: u }
  }
  result room
}

// Finds or creates the direct room with exactly these users (and you).
action create_direct_room(users: set of User) {                    // R5: rooms/direct.rb find_or_create_for
  let everyone = users + set(actor)
  let existing = first_or_none(Room where .type == direct and same_members(it, everyone))
  if existing != none {
    result existing
  } else {
    create Room { type: direct, creator: actor } as room
    for each u in User where u in everyone { ensure Membership { room: room, user: u } }
    result room
  }
}

// Renames a room and makes it open: every active user becomes a member. Its creator and administrators only.
action update_open_room(room: Room, name: Text) {                  // R9: becomes open
  require member(actor, room) and room.type != direct else not_found   // R11, R12
  require can_administer(actor, room.creator) else forbidden       // R8
  set room.name = name
  set room.type = open
  result room
}

// Renames a room, makes it closed, and sets its members to exactly the given active users; include yourself to stay in it. Its creator and administrators only.
action update_closed_room(room: Room, name: Text, users: set of User) {
  require member(actor, room) and room.type != direct else not_found
  require can_administer(actor, room.creator) else forbidden
  set room.name = name
  set room.type = closed
  for each u in User where u in users and .status == active { ensure Membership { room: room, user: u } }   // R10; only active people
  delete Membership where .room == room and not (.user in users)
  result room
}

trigger on create Room as r when r.type == open {                  // R3: rooms/open.rb
  for each u in User where .status == active { ensure Membership { room: r, user: u } }
}
trigger on update Room.type as r when r.type == open and old.type != open {   // R9
  for each u in User where .status == active { ensure Membership { room: r, user: u } }
}
trigger on update Room.type as r when old.type == direct and r.type != direct {   // R11
  reject invalid
}
trigger on delete Membership as m {                                // membership.rb after_destroy_commit
  emit Disconnect(m.user)
}

// Deletes a room with its messages. Administrators and the room's creator only.
action delete_room(room: Room) {
  require member(actor, room) else not_found
  require can_administer(actor, room.creator) else forbidden       // R13
  delete room                                                      // R14
}

// Deletes a direct room you are in, with its messages.
action delete_direct_room(room: Room) {                            // rooms/directs_controller.rb: any member
  require member(actor, room) and room.type == direct else not_found
  delete room
}

// ======================================================================== memberships and presence

// Sets which of a room's messages notify you: everything, mentions, nothing, or invisible (hidden from the sidebar).
action set_involvement(room: Room, involvement: Involvement) {     // rooms/involvements_controller.rb
  require member(actor, room) else not_found                       // M2
  set the(Membership where .room == room and .user == actor).involvement = involvement
}

// The presence channel calls these as a client opens, closes and keeps alive a room
// (membership/connectable.rb, channels/presence_channel.rb). They are internal: no screen
// or API offers them.
action present(room: Room) {
  callers internal
  require member(actor, room) else not_found
  let m = the(Membership where .room == room and .user == actor)
  set m.connections = if connected(m) { m.connections + 1 } else { 1 }
  set m.connected_at = now
  set m.unread_since = none                                        // U3
}
// Marks you as no longer looking at a room (the presence channel calls it).
action absent(room: Room) {
  callers internal
  require member(actor, room) else not_found
  let m = the(Membership where .room == room and .user == actor)
  set m.connections = if connected(m) { m.connections - 1 } else { 0 }
  if m.connections < 1 { set m.connected_at = none }
}
// Keeps your presence in a room alive (the presence channel calls it).
action refresh_connection(room: Room) {
  callers internal
  require member(actor, room) else not_found
  let m = the(Membership where .room == room and .user == actor)
  if not connected(m) { set m.connections = m.connections + 1 }
  set m.connected_at = now
}

// ======================================================================== messages

// Posts a message to a room you are a member of: text (mention people with @name), a file, or both.
action post_message(room: Room, body: RichText, attachment: File?) {   // messages_controller.rb create
  require member(actor, room) else not_found                       // G1
  require not blank(body) or attachment != none else invalid
  create Message { room: room, creator: actor, body: body, attachment: attachment } as message   // G2
  emit MessagePosted(message)
  result message
}

trigger on create Message as m {                                   // U1: room.rb unread_memberships
  for each ms in Membership where .room == m.room and .user != m.creator and visible(ms) and not connected(ms) {
    set ms.unread_since = m.created
  }
}

// Changes a message's text. Its author and administrators only.
action edit_message(message: Message, body: RichText) {
  require member(actor, message.room) else not_found               // G4
  require can_administer(actor, message.creator) else forbidden    // G3
  set message.body = body
  result message
}

// Deletes a message and its boosts. Its author and administrators only.
action delete_message(message: Message) {
  require member(actor, message.room) else not_found
  require can_administer(actor, message.creator) else forbidden
  delete message                                                   // G5: boosts by cascade
}

// Adds a boost (a short reaction, often an emoji) to a message.
action boost(message: Message, content: Text) {
  require member(actor, message.room) else not_found               // B1: reachable_messages
  require present(content) else invalid
  create Boost { message: message, booster: actor, content: content } as boost
  result boost
}

// Removes one of your boosts.
action unboost(boost: Boost) {
  require member(actor, boost.message.room) else not_found
  require boost.booster == actor else not_found                    // B3
  delete boost
}

// Push notifications and bot webhooks, after the message is saved
// (room/message_pusher.rb, messages_controller.rb deliver_webhooks_to_bots).
workflow on MessagePosted(m) {
  step push:
    for each ms in Membership where .room == m.room and .user != m.creator and visible(ms) and not connected(ms)
                                and (.involvement == everything or (.involvement == mentions and .user in mentionees(m))) {
      for each sub in PushSubscription where .user == ms.user {
        let sent = call web_push(sub.endpoint, sub.p256dh_key, sub.auth_key,
          title: if m.room.type == direct { m.creator.name } else { m.room.name },
          body: if m.room.type == direct { plain_body(m) } else { m.creator.name + ": " + plain_body(m) },
          path: url_of(room_screen(m.room)),
          badge: count(Membership where .user == ms.user and unread(it)))
        if sent == "expired" { delete sub }                          // config/initializers/web_push.rb
      }
    }
  step webhooks:
    for each bot_user in User where .role == bot and .status == active and bot_user != m.creator
                         and (if m.room.type == direct { member(bot_user, m.room) } else { bot_user in mentionees(m) }) {
      for each hook in Webhook where .user == bot_user {
        let reply = call post_json(hook.url, webhook_payload(m, bot_user), timeout: 7 s)
        if reply.timed_out {
          create Message { room: m.room, creator: bot_user, body: rich("Failed to respond within 7 seconds") }
        } else if reply.status == 200 and reply.content_type in ["text/html", "text/plain"] {
          create Message { room: m.room, creator: bot_user, body: rich(reply.text) }
        } else if reply.content_type != none {
          create Message { room: m.room, creator: bot_user, body: rich(""), attachment: file(reply.body, "attachment", reply.content_type) }
        }
      }
    }
}

fn webhook_payload(m: Message, bot: User): Json = json {          // webhook.rb payload
  user: { id: m.creator.id, name: m.creator.name },
  room: { id: m.room.id, name: m.room.name, path: url_of(bot_messages(m.room, bot_key(bot))) },
  message: { id: m.id, body: { html: html(m.body), plain: trim(replace(plain_body(m), "@" + bot.name, "")) }, path: url_of(room_screen(m.room, m)) }
}

extern fn web_push(endpoint: Url, p256dh: Text?, auth: Text?, title: Text, body: Text, path: Url, badge: Int): Text effect push   // "sent", "expired" or "failed"
extern fn post_json(url: Url, body: Json, timeout: Duration): HttpReply effect http
extern fn opengraph(url: Url): OpenGraph? effect fetch           // opengraph/*: guarded against private networks

// A link's preview: its title, description and image, read from the page.
view unfurl_link(link: Url) { value call opengraph(unfurl_target(link)) }   // unfurl_links_controller.rb: no content when invalid
// opengraph/metadata/fetching.rb: Twitter and X don't serve OpenGraph, so tweets are read through fxtwitter.com
fn unfurl_target(link: Url): Url =
  if host(link) in ["twitter.com", "www.twitter.com", "x.com", "www.x.com"] and present(path(link)) and path(link) != "/"
  { with_host(link, "fxtwitter.com") } else { link }

// ======================================================================== search

// Records a search in your recent searches, as the search box does; search_results returns the matches.
action search(query: Text) {                                       // searches_controller.rb create; search.rb record
  let q = words_only(query)
  ensure Search { user: actor, query: q }
  touch the(Search where .user == actor and .query == q)
  delete Search where .user == actor and not (it in list(it for Search where .user == actor order by updated desc limit 10))
  result q
}

// Clears your recent searches.
action clear_searches() { delete Search where .user == actor }

// ======================================================================== push subscriptions

// Registers a browser for push notifications.
action subscribe_push(endpoint: Url, p256dh_key: Text?, auth_key: Text?) {   // users/push_subscriptions_controller.rb
  let existing = first_or_none(PushSubscription where .user == actor and .endpoint == endpoint and .p256dh_key == p256dh_key and .auth_key == auth_key)   // find_by: the first match; rows aren't unique
  if existing != none {
    touch existing
  } else {
    create PushSubscription { user: actor, endpoint: endpoint, p256dh_key: p256dh_key, auth_key: auth_key, user_agent: request.user_agent }
  }
}

// Removes one of your push registrations.
action unsubscribe_push(subscription: PushSubscription) {
  require subscription.user == actor else not_found
  delete subscription
}

// Sends a test push notification to one of your registrations.
action send_test_notification(subscription: PushSubscription) {
  require subscription.user == actor else not_found
  emit TestPush(subscription)
}
workflow on TestPush(sub) {                                           // push_subscriptions/test_notifications_controller.rb
  step deliver:
    let sent = call web_push(sub.endpoint, sub.p256dh_key, sub.auth_key, title: "Campfire Test", body: token(16),
      path: url_of(push_subscriptions_screen()), badge: count(Membership where .user == sub.user and unread(it)))
    if sent == "expired" { delete sub }
}

// ======================================================================== views

// A room's messages, oldest first: the latest 40, or the page before or after a message, or the messages around one.
view room_messages(room: Room, before: Message?, after: Message?, around: Message?) {   // G6, message/pagination.rb
  updates live
  require member(actor, room) else not_found
  rows Message where .room == room
    and (before == none or .created < before.created)
    and (after == none or .created > after.created)
  order by created
  page 40 last unless after != none
  page 40 around around                                                 // page_around: 40 before, the message, 40 after
}

// Your rooms, as the sidebar lists them: one Membership per room, naming the room and whether it has unread messages (unread_since).
view sidebar_rooms() {                                        // users/sidebars_controller.rb
  updates live
  rows Membership where .user == actor and visible(it)
  order by lower(.room.name)
}

// People you could start a direct room with: up to 20 you aren't in a direct room with yet.
view direct_placeholders() {                                  // up to 20 people to start a direct room with
  updates live
  rows User where .status == active and it != actor and not in_direct_room_with(it, actor)
  order by created
  limit max(0, 20 - count(distinct(list(.user for Membership where .room.type == direct and member(actor, .room)))))
}

// The account's people (bots aside); administrators also see banned ones.
view account_users() {                                             // accounts_controller.rb edit
  rows User where .role != bot and (if can_administer(actor, none) { .status in {active, banned} } else { .status == active })
  order by lower(.name)
  page 500
}

// The account's bots. Administrators only.
view bots() {
  require can_administer(actor, none) else forbidden
  rows User where .role == bot and .status == active
  order by lower(.name)
}

// Messages matching a search in the rooms you are a member of, oldest first: the latest 100.
view search_results(query: Text) {
  rows Message where member(actor, .room) and matches(.body, words_only(query))
  order by created
  page 100 last
}

// Your recent searches, latest first.
view recent_searches() { rows Search where .user == actor  order by updated desc }

// Active users whose name contains filter, in a room's members when room is given: who you can mention.
view autocomplete_users(room: Room?, filter: Text?) {               // autocompletable/users_controller.rb
  rows User where .status == active
    and (room == none or member(it, room))
    and (filter == none or contains(lower(.name), lower(filter)))
  order by lower(.name)
  page 20
}

// Your push notification registrations.
view push_subscriptions() { rows PushSubscription where .user == actor }

// ======================================================================== real time

channel presence(room: Room) {                                       // channels/presence_channel.rb
  require member(actor, room)
  on open present(room)
  on close absent(room)
  every 50 s refresh_connection(room)
}

signal typing(room: Room) { to set(User where member(it, room)) carries { action: Text }   // typing_notifications_channel.rb
  require member(actor, room)
}

// Room message, sidebar and unread streams are the live views above. Their audiences come
// from the read permissions, so a revoked membership stops delivery (room_messages_channel.rb).

// ======================================================================== bot API

api bot_messages {   // messages/by_bots_controller.rb
  route "/rooms/:room/:bot_key/messages"
  identity bot_key
  skip policy deny_bots
  get "" -> room_messages(room, before: query.before, after: query.after) as json message_json
           headers { "X-Total-Count": count(Message where .room == room) }
  post "" -> post_message(room, body: rich(request.text), attachment: request_file("attachment")) status 201
             location url_of(room_screen(room, result))                      // the message, in its room
  put ":message" -> edit_message(message, body: rich(request.text)) as json message_json
  delete ":message" -> delete_message(message) status 204
  post ":message/boosts" -> boost(message, content: request.text) status 201 as json boost_json
  delete ":message/boosts/:boost" -> unboost(boost) status 204
}

fn message_json(m: Message): Json = json {
  id: m.id, body: { html: html(m.body), plain: plain_body(m) }, created_at: m.created,
  creator: { id: m.creator.id, name: m.creator.name }, room: { id: m.room.id, name: m.room.name }
}
fn boost_json(b: Boost): Json = json { id: b.id, content: b.content, booster: { id: b.booster.id, name: b.booster.name } }

// ======================================================================== UI

app campfire {
  name "Campfire"
  about "Group chat for one team: rooms (open to everyone, closed to chosen people, or direct), messages with mentions, files and boosts, and search."   // for agents (llms.txt, MCP)
  actor User                                                       // who signs in and acts
  sign_in_screen sign_in_screen                                           // where signed-out visitors go
  setup_screen first_run_screen                                           // sessions_controller.rb ensure_user_exists
  setup_when not exists(User)
  indexes auto                                                     // the indexes its queries want, kept in step (lang/cost.ts)
}

show User {
  label: .name
  picture: if .avatar != none { .avatar } else if .role == bot { "default-bot-avatar.svg" } else { initials(.name) }
}   // users/avatars_controller.rb

theme campfire {
  stylesheets ["_reset.css", "actiontext.css", "animation.css", "autocomplete.css", "avatars.css", "base.css", "boosts.css", "buttons.css",
    "code.css", "colorize.css", "colors.css", "composer.css", "embeds.css", "filters.css", "flash.css", "inputs.css", "layout.css", "lightbox.css",
    "messages.css", "nav.css", "panels.css", "separators.css", "sidebar.css", "signup.css", "spinner.css", "utilities.css"]   // app/assets/stylesheets, unchanged, in the order Rails links them (stylesheet_link_tag :all: by name), so utilities come last and win
  custom Account.custom_styles
  avatar_colors ["#AF2E1B", "#CC6324", "#3B4B59", "#BFA07A", "#ED8008", "#ED3F1C", "#BF1B1B", "#736B1E", "#D07B53",
    "#736356", "#AD1D1D", "#BF7C2A", "#C09C6F", "#698F9C", "#7C956B", "#5D618F", "#3B3633", "#67695E"]   // users/avatars_helper.rb AVATAR_COLORS
  brand json { href: "https://once.com", label: "Once software from 37signals home page", image: "campfire-icon.png", alt: "Campfire logo" }   // layouts/application: #app-logo
  logo if Account.logo != none { Account.logo } else { "logos/app-icon.png" }
  classes {                                                   // Campfire's class names for the runtime's markup
    row: "flex align-center gap",   // a Switch's row
    icon: "colorize--black", avatar: "avatar", avatar_large: "txt-xx-large center",
    button: "btn", submit: "btn btn--reversed center", plain_button: "btn btn--plain", selected: "btn--reversed",

    dropdown: "position-relative", dropdown_panel: "border shadow pad",
    form: "flex flex-column gap", fieldset: "flex flex-column gap borderless unpad", button_form: "flex-inline",
    field: "flex align-center gap input input--actor", input: "input",
    choices: "flex flex-column gap", choice: "flex align-center gap", picker_item: "btn",
    signal: "typing-indicator gap txt-small align-center flex-inline", signal_author: "typing-indicator__author spinner", signal_active: "typing-indicator--active", screen_reader: "for-screen-reader",
    embed: "attachment attachment--content attachment--og", embed_body: "og-embed gap", embed_content: "og-embed__content",
    embed_title: "og-embed__title", embed_description: "og-embed__description", embed_image: "og-embed__image"
  }
}

// Campfire's own widgets, implemented in widgets.ts (run the runtime with --widgets apps/campfire/widgets.ts)
widget sound(file: Text)
widget reply(text: Text)
widget jump_to_newest()
widget format_messages()
widget pwa_install_instructions()

layout app {
  <Title />
  <nav>
    <Slot name=nav />
  </nav>
  <Flash />
  <main>
    <Slot name=main />
    <footer>
      <Slot name=footer />
    </footer>
  </main>
  <aside>
    <Slot name=sidebar />
  </aside>
}

// ---- getting in

screen first_run_screen {
  route "/first_run"
  layout app
  access public
  require not exists(Account) else go home
  <Title>Set up Campfire</Title>
  <Fill name=main>
    <Form action={first_run} class="nametag">
      <h1 class="txt-large">Set up Campfire</h1>
      <Field label_hidden name=avatar kind=file label="Add your avatar" accept="image/*" />
      <Field name=name kind=text placeholder="Name" icon="person" />
      <Field name=email kind=email placeholder="Email address" icon="email" />
      <Field name=password kind=password placeholder="Password" icon="password" />
      <Submit icon="arrow-right" label="Save" />
      <On ok sign_in={result} go={home} />
    </Form>
  </Fill>
}

screen sign_in_screen(email: Email?) {
  route "/session/new"
  layout app
  access public
  require exists(User) else go first_run_screen
  <Title>Sign in</Title>
  <Fill name=main>
    <section class="panel">
      <Image>{theme.logo}</Image>
      <Form action={sign_in}>
        <h1 class="txt-large">{Account.name}</h1>
        <Field name=email kind=email value={email} placeholder="Enter your email address" icon="email" />
        <Field name=password kind=password placeholder="Enter your password" icon="password" />
        <Submit icon="arrow-right" label="Go" />
        <On ok sign_in={result} go={home} />
        <On unauthenticated flash="Too many requests or unauthorized." shake />
        <On blocked flash="Too many requests or unauthorized." shake />
      </Form>
    </section>
  </Fill>
}

screen join_screen(join_code: Text) {
  route "/join/:join_code"
  layout app
  access public
  require join_code == Account.join_code else not_found
  <Title>Sign up</Title>
  <Fill name=nav>
    <Link to={sign_in_screen(none)} icon="login-keys" label="Sign in" />
  </Fill>
  <Fill name=main>
    <Form action={join(join_code)} class="nametag">
      <h1 class="txt-large">{Account.name}</h1>
      <Field label_hidden name=avatar kind=file label="Upload avatar" accept="image/*" />
      <Field name=name kind=text placeholder="Name" icon="person" />
      <Field name=email kind=email placeholder="Email address" icon="email" />
      <Field name=password kind=password placeholder="Password" icon="password" />
      <Submit icon="check" label="Save" />
      <On ok sign_in={result} go={home} />
      <On unauthenticated go={sign_in_screen(input.email)} />
    </Form>
  </Fill>
}

screen transfer_screen(link: Text) {
  route "/session/transfers/:link"
  layout app
  access public
  <Fill name=main>
    <Form action={transfer_session(link)}>
      <Submit label="Sign in on this device" />
      <On ok sign_in={result} go={home} />
    </Form>
  </Fill>
}

// ---- home and rooms

screen home {
  route "/"
  layout app
  {if any(list(it for Membership where .user == actor)) {
    <Go to={room_screen(last_room_visited())} />
  }}
  <Title>No rooms yet</Title>
  <Fill name=sidebar>
    <SidebarPanel />
  </Fill>
  <Fill name=main>
    <section class="message-area" id="message-area">
      <section class="message-area--empty min-width center">
        <Icon>{"messages-empty"}</Icon>
      </section>
    </section>
  </Fill>
}
fn last_room_visited(): Room? =                                     // tracked_room_visit.rb
  if exists(Room where text(.id) == cookie("last_room") and member(actor, it))
  { the(Room where text(.id) == cookie("last_room"))
  } else { first(list(it for Room where member(actor, it) order by created)) }

screen room_screen(room: Room, at: Message?) {
  route "/rooms/:room"
  layout app
  remember last_room
  require member(actor, room) else go home flash "Room not found or inaccessible"
  <Title>{display_name(room, actor)}</Title>
  <Channel call={presence(room)} />
  <Fill name=nav>
    {if Account.logo != none {
      <Image class="account-logo">{Account.logo}</Image>
    }}
    <div class="btn btn--reversed btn--faux room--current">               // rooms/show/_nav.html.erb
      <h1 class="room__contents txt-medium overflow-ellipsis">{display_name(room, actor)}</h1>
    </div>
    <Link to={edit_room_screen(room)} icon="menu-dots-horizontal" label={"Settings for this " + (if room.type == direct { "Ping" } else { "room" })} />
    <NotificationsBell room={room} />
  </Fill>
  <Fill name=sidebar>
    <SidebarPanel />
  </Fill>
  <Fill name=main>
    <section class="message-area" id="message-area">
      {if room == original_room() and count(Message where .room == room) <= 40 {
        <Invitation />
      }}
      <List of={room_messages(room, around: at)} as=m class="messages">
        <MessageItem m={m} />
      </List>
      <Widget call={jump_to_newest} />
      <Widget call={format_messages} />
    </section>
  </Fill>
  <Fill name=footer>
    <Composer room={room} />
  </Fill>
}

component Composer(room: Room) {  // rooms/show/_composer.html.erb
  <div class="composer flex align-end gap position-relative">
    <Link to={search_screen(none)} icon="search" label="Search" class="btn flex-item-no-shrink composer__context-btn" />
    <Form action={post_message(room)} id="composer" class="margin-block flex-item-grow contain" bare>
      <div class="flex composer__input input input--actor fill-white min-width">
        <Icon class="composer__input-hint colorize--black">{"messages-outlined"}</Icon>
        <Field label_hidden name=body kind=richtext label="Write a message" class="flex-item-grow min-width" mentions={autocomplete_users(room, typed)} unfurl={unfurl_link} drafts />
        <Field label_hidden name=attachment kind=file label="Attach a file" icon="attachment" class="btn btn--borderless txt-small flex-item-no-shrink input--file" />
        <Submit icon="arrow-up" label="Send Message" />
      </div>
      <On ok stay clear_form />
    </Form>
    <Signal call={typing(room)} indicator />
  </div>
}

component MessageItem(m: Message) {  // messages/_message.html.erb
  <div class={"message message--formatted" + (if m.creator == actor { " message--me" } else { "" })} id={"message_" + m.client_id} data-message-id={m.id} data-mentioned={if actor in mentionees(m) { "true" } else { "false" }} data-user-id={m.creator.id}>  // messages_helper.rb message_tag
    <div class="message__day-separator">
      <Time as={date} class="message__timestamp">{m.created}</Time>
    </div>
    <div class="avatar message__avatar">
      <Link to={user_screen(m.creator)} class="btn avatar" title={m.creator.name}>
        <Avatar bare>{m.creator}</Avatar>
      </Link>
    </div>
    <div class="message__body">
      <div class="message__body-content">
        <div class="message__meta">
          <div class="message__heading">
            <div class="message__author" title={user_title(m.creator)}>
              <strong>{m.creator.name}</strong>
            </div>
            <Link to={room_screen(m.room, m)} class="message__permalink">
              <Time as={time} class="message__timestamp">{m.created}</Time>
            </Link>
          </div>
          <div class="message__actions">
            <MessageActions m={m} />
          </div>
        </div>
        {if sound_of(m) != none {
          <div class="sound">
            <Widget call={sound(sound_of(m).name + ".mp3")} />
            {if sound_of(m).image != none {
              <Image width={sound_of(m).width} height={sound_of(m).height}>{"sounds/" + sound_of(m).image}</Image>
            } else {
              <span>{sound_of(m).text}</span>
            }}
          </div>
        } else if m.attachment != none {
          <Widget call={lightbox(m.attachment)} caption={plain(m.body)} />
        } else {
          <RichText autolink class="message__presentation" id={"presentation_message_" + text(m.id)}>{m.body}</RichText>  // dom_id(message, :presentation)
        }}
        <div class="boosts flex flex-wrap align-center gap full-width">
          <List of={Boost where .message == m order by created} as=b>
            <BoostItem b={b} />
          </List>
        </div>
      </div>
    </div>
  </div>
}

component MessageActions(m: Message) {
  <Popup icon="menu-dots-horizontal" label="Message options" class="btn message__action-btn message__options-btn" panel="message__actions-menu border shadow">
    <div class="quick-boosts">
      {for each r in list(it for Reaction) {
        <Button action={boost(m, r.character)} text={r.character} label={r.title} />
      }}
      <Popup label="New boost" icon="boost" class="message__action-btn" panel="message__actions-menu border shadow">   // messages/boosts/new
        <Form action={boost(m)} class="boost__form flex align-center gap">
          <Field name=content kind=text maxlength={16} required />
          <Submit icon="check" label="Submit" />
        </Form>
      </Popup>
    </div>
    <div class="flex align-center gap">
      {if m.attachment != none {
        <Link href={download(m.attachment)} icon="download" label="Download" />
        <Widget call={share_button(m.attachment)} icon="share" />
      } else {
        <Widget call={reply(plain_body(m))} icon="reply" label="Reply" />
      }}
      <Widget call={copy_button(url_of(room_screen(m.room, m)))} icon="link" label="Copy link" />
      {if can_administer(actor, m.creator) {
        <Popup icon="pencil" label="Edit" class="message__action-btn" panel="message__actions-menu border shadow">
          <Form action={edit_message(m)}>
            <Field name=body kind=richtext value={m.body} />
            <Submit icon="check" label="Save" />
            <On ok stay />
          </Form>
          <Button action={delete_message(m)} icon="trash" label="Delete" confirm="Are you sure?" />
        </Popup>
      }}
    </div>
  </Popup>
}

component BoostItem(b: Boost) {
  <div class="boost">
    <Avatar label={b.booster.name + " boosted " + b.content}>{b.booster}</Avatar>
    <span>{b.content}</span>
    {if b.booster == actor {
      <Button action={unboost(b)} icon="minus" label="Delete this boost" reveal />
    }}
  </div>
}

// the bell in a room's nav: turning notifications on in this browser (rooms/involvements/_bell)
component NotificationsBell(room: Room) {
  <Widget call={push_permission(subscribe_push)} icon="notification-bell-alert" label={"Notification settings for this " + (if room.type == direct { "Ping" } else { "room" })} />
}
// a room's involvement, changed a step at a time (button_to_change_involvement): a setting
// that shows its state, as a checkbox to assistive tech
component InvolvementToggle(room: Room) {
  {let current = the(Membership where .room == room and .user == actor).involvement}
  <Button action={set_involvement(room, next_involvement(room, current))} icon={"notification-bell-" + current} label={label_of(current)} checked={true} class={"btn " + current} />
}
fn next_involvement(room: Room, v: Involvement): Involvement =    // SHARED_INVOLVEMENT_ORDER, DIRECT_INVOLVEMENT_ORDER
  if room.type == direct { if v == everything { nothing } else { everything } }
  else if v == mentions { everything } else if v == everything { nothing } else if v == nothing { invisible } else { mentions }
fn label_of(v: Involvement): Text =                                 // HUMANIZE_INVOLVEMENT
  if v == mentions { "Notifying about @ mentions" } else if v == everything { "Notifying about all messages" }
  else if v == nothing { "Notifications are off" } else { "Notifications are off and room invisible in sidebar" }

component Invitation() {                                           // rooms/show/_invitation.html.erb
  <section class="message message--formatted txt-align-center center" id="system_welcome">
    <div class="message__body center">
      <div class="message__body-content position-relative">
        <Image class="account-logo center margin-block-end" width={64} height={64}>{theme.logo}</Image>
        <div class="flex align-center gap">
          <div class="flex flex-column">
            <strong>Welcome to Campfire</strong>
            <span>To invite people to chat, share the join link below.</span>
          </div>
        </div>
        <Invite />
      </div>
    </div>
  </section>
}

component Invite() {                                                // accounts/_invite.html.erb
  <div class="flex flex-column align-center gap">
    <div class="flex flex-column gap full-width">
      <strong class="invite-label">Share to invite more people</strong>
      <div class="flex align-center gap input input--actor fill-white">
        <Icon>{"person-add"}</Icon>
        <FieldDisplay readonly label="Share to invite more people">{join_url()}</FieldDisplay>
      </div>
    </div>
    <div class="flex align-center gap">
      <Widget call={qr_link(join_url())} icon="qr-code" label="Show join link QR code" />
      <Widget call={copy_button(join_url())} icon="copy-paste" label="Copy join link" />
      <Widget call={share_button(join_url(), "Link to join Campfire", "Hit this link to join me in Campfire and start chatting.")} icon="share" label="Share join link" />
      {if can_administer(actor, none) {
        <Button action={reset_join_code()} icon="refresh" label="Regenerate join link" class="btn btn--regenerate" />
      }}
    </div>
  </div>
}

component SidebarPanel() {                                         // users/sidebars/show.html.erb
  <div class="sidebar__container overflow-y overflow-hide-scrollbar">
    <div class="directs gap overflow-x overflow-hide-scrollbar">
      <Link to={new_direct_screen()} class="direct direct__new">
        <div class="avatar avatar--icon">
          <Icon>{"messages-add"}</Icon>
        </div>
        <div class="direct__author flex max-width min-width border-radius pad-inline-half">
          <span class="for-screen-reader">New</span>
          <span class="txt-small overflow-clip">Ping</span>
        </div>
      </Link>
      <List of={sidebar_rooms()} as=ms where={ms.room.type == direct} order={ms.room.updated} desc>
        <Link to={room_screen(ms.room)} class="direct" unread={unread(ms)}>
          <Avatars>{list(.user for Membership where .room == ms.room and .user != actor limit 4)}</Avatars>
          <div class="direct__author flex align-center gap max-width min-width border-radius txt-small">
            <span class="txt-nowrap overflow-ellipsis">{direct_label(ms.room)}</span>
          </div>
        </Link>
      </List>
      <List of={direct_placeholders()} as=u>
        <Button action={create_direct_room(set(u))} class="direct borderless fill-transparent unpad">
          <div class="avatar">
            <Avatar bare>{u}</Avatar>
          </div>
          <div class="direct__author flex align-center gap max-width min-width border-radius txt-small">
            <div class="txt-nowrap overflow-ellipsis">
              <span class="for-screen-reader">Start a ping with</span>
              <span>{first_word(u.name)}</span>
            </div>
          </div>
        </Button>
      </List>
    </div>
    <div class="rooms position-relative flex flex-column gap">
      <List of={sidebar_rooms()} as=ms where={ms.room.type != direct}>
        <Link to={room_screen(ms.room)} class="align-center gap room btn txt-nowrap" unread={unread(ms)}>
          <span class="overflow-ellipsis">{ms.room.name}</span>
        </Link>
      </List>
      {if may_create_rooms(actor) {
        <Link to={new_room_screen()} icon="add" title="New Chat Room" class="rooms__new-btn btn room align-center gap txt-reversed" />
      }}
    </div>
  </div>
  <div class="flex align-end sidebar__tools gap justify-end">
    <Link to={profile_screen()} class="btn avatar flex-item-no-shrink sidebar__tool">
      <Avatar bare>{actor}</Avatar>
      <span class="for-screen-reader">My Settings</span>
    </Link>
    <Link to={account_screen()} icon="settings" label="Account Settings" class="btn align-center gap txt-reversed sidebar__tool" />
  </div>
}
fn direct_label(r: Room): Text =
  if count(Membership where .room == r and .user != actor) > 1
  { sentence(list(initials(.user.name) for Membership where .room == r and .user != actor))
  } else { first_word(display_name(r, actor)) }

// ---- creating and editing rooms

screen new_room_screen(closed: Bool?) {
  route "/rooms/opens/new"
  layout app
  require may_create_rooms(actor) else forbidden
  <Title>New chat room</Title>
  <Fill name=nav>
    <Link to={room_screen(last_room_visited())} icon="arrow-left" label="Go Back" />   // link_back_to_last_room_visited
  </Fill>
  <Fill name=main>
    <section class="panel txt-align-center">                         // rooms/layouts/_new, _form
      {if closed == true {
        <Form action={create_closed_room}>
          <Field label_hidden name=name kind=text value="New room" placeholder="Name the room" label="Name this room" />
          <section class="room-access margin-block pad-inline fill-shade border-radius">
            <EveryoneRow open={false} room={none} />
            <Field name=users kind=users from={list(it for User where .status == active order by lower(.name))} filter_over={20} />
          </section>
          <Submit icon="check" label="Save" />
          <On ok go={room_screen(result)} />
        </Form>
      } else {
        <Form action={create_open_room}>
          <Field label_hidden name=name kind=text value="New room" placeholder="Name the room" label="Name this room" />
          <section class="room-access margin-block pad-inline fill-shade border-radius">
            <EveryoneRow open={true} room={none} />
            {for each u in list(it for User where .status == active order by lower(.name)) {
              <MemberRow u={u} />
            }}
          </section>
          <Submit icon="check" label="Save" />
          <On ok go={room_screen(result)} />
        </Form>
      }}
    </section>
  </Fill>
}
// rooms/opens/_form, rooms/closeds/_form: everyone, and the switch to the other kind of room
component EveryoneRow(open: Bool, room: Room?) {
  <div class="flex align-center gap margin-none">
    <div class="avatar flex-item-no-shrink">
      <Icon>{"everyone"}</Icon>
    </div>
    <strong class="overflow-ellipsis fill-shade">Everyone</strong>
    <Separator />
    {if room == none {
      {if open {
        <Switch label="Give only some access to this room" on link={new_room_screen(true)} />
      } else {
        <Switch label="Give everyone access to this room" off link={new_room_screen(false)} />
      }}
    } else if can_administer(actor, room.creator) {
      {if open {
        <Switch label="Give only some access to this room" on link={edit_room_screen(room, true)} />
      } else {
        <Switch label="Give everyone access to this room" off link={edit_room_screen(room, false)} />
      }}
    }}
  </div>
  <Separator />
}
// rooms/opens/_user: a person, their avatar a link to them
component MemberRow(u: User) {
  <div class="flex align-center gap margin-none">
    <div class="avatar flex-item-no-shrink">
      <Link to={user_screen(u)} class="btn avatar" title={u.name}>
        <Avatar bare>{u}</Avatar>
      </Link>
    </div>
    <strong class="overflow-ellipsis fill-shade">{u.name}</strong>
    <Separator />
    <Icon>{"check"}</Icon>
  </div>
}

screen edit_room_screen(room: Room, closed: Bool?) {
  route "/rooms/:room/edit"
  layout app
  require member(actor, room) else go home flash "Room not found or inaccessible"
  <Title>{"Edit settings for " + display_name(room, actor)}</Title>
  <Fill name=nav>
    <Link to={room_screen(room)} icon="arrow-left" label="Go Back" />
  </Fill>
  <Fill name=main>
    <section class="panel">
      {if room.type == direct {
        {for each u in list(.user for Membership where .room == room and (.user != actor or count(Membership where .room == room) == 1)) {
          <div class="member">
            <Avatar>{u}</Avatar>
            <strong>{u.name}</strong>
          </div>
        }}
        <Button action={delete_direct_room(room)} icon="trash" text="Ping" confirm="Are you sure you want to delete this ping and all messages in it? This can’t be undone." />
        <On ok go={home} />
      } else if (closed == none and room.type == "closed") or closed == true {
        <Form action={update_closed_room(room)} readonly_unless={can_administer(actor, room.creator)}>
          <Field label_hidden name=name kind=text value={room.name} placeholder="Name the room" label="Name this room" />
          <section class="room-access margin-block pad-inline fill-shade border-radius">
            <EveryoneRow open={false} room={room} />
            <Field name=users kind=users value={set(User where member(it, room))} from={list(it for User where .status == active order by lower(.name))} filter_over={20} />
          </section>
          <Submit icon="check" label="Save" />
          <On ok go={room_screen(result)} />
        </Form>
      } else {
        <Form action={update_open_room(room)} readonly_unless={can_administer(actor, room.creator)}>
          <Field label_hidden name=name kind=text value={room.name} placeholder="Name the room" label="Name this room" />
          <section class="room-access margin-block pad-inline fill-shade border-radius">
            <EveryoneRow open={true} room={room} />
            {for each u in list(it for User where .status == active order by lower(.name)) {
              <MemberRow u={u} />
            }}
          </section>
          <Submit icon="check" label="Save" />
          <On ok go={room_screen(result)} />
        </Form>
      }}
    </section>
    {if room.type != direct and can_administer(actor, room.creator) {
      <section class="panel">
        <Button action={delete_room(room)} icon="trash" text={room.name} confirm="Are you sure you want to delete this room and all messages in it? This can’t be undone." />
        <On ok go={home} />
      </section>
    }}
  </Fill>
}

screen new_direct_screen {
  route "/rooms/directs/new"
  layout app
  <Fill name=main>
    <div class="directs directs--new flex flex-column gap">       // rooms/directs/new.html.erb
      <Form action={create_direct_room} class="flex gap flex-item-grow">
        <Link to={home} icon="arrow-left" label="Cancel changes" class="btn flex-item-no-shrink" />
        <section class="autocomplete__container unpad input input--actor">
          <Field name=users kind=users autocomplete={autocomplete_users(none, typed)} required />
        </section>
        <Submit icon="check" label="Start Ping" />
        <On ok go={room_screen(result)} />
      </Form>
      <span class="txt-small translucent pad-inline-half center">Type names to ping someone…</span>
    </div>
  </Fill>
}

// ---- search

screen search_screen(q: Text?) {
  route "/searches"
  layout app
  <Title>Search</Title>
  <Fill name=nav>
    {if q != none {
      <div class="flex align-center gap">
        <span>{"“" + q + "”"}</span>
        <span>{text(count(search_results(q)))}</span>
      </div>
    }}
    <RecentSearchesBar />
  </Fill>
  <Fill name=sidebar>
    <RecentSearchesBar />
  </Fill>
  <Fill name=main>
    <section class="message-area" id="message-area">
      {if q != none {
        <List of={search_results(q)} as=m class="messages">
          <MessageItem m={m} />
        </List>
      } else {
        <section class="message-area--empty min-width center">
          <Icon>{"search"}</Icon>
        </section>
      }}
    </section>
  </Fill>
  <Fill name=footer>
    <div class="composer">
      <Link to={room_screen(last_room_visited())} icon="arrow-left" label="Exit search" />
      <Form action={search}>
        <Field label_hidden name=query kind=text value={q} role="searchbox" label="search" required />
        <Submit icon="arrow-up" label="Search" />
        <On ok go={search_screen(result)} />
      </Form>
    </div>
  </Fill>
}

component RecentSearchesBar() {
  <List of={recent_searches()} as=s>
    <Link to={search_screen(s.query)} class="room">
      <span>{"“" + s.query + "”"}</span>
    </Link>
  </List>
  {if exists(Search where .user == actor) {
    <Button action={clear_searches()} icon="broom" label="Clear recent searches" confirm="Are you sure you want to clear your recent searches?" />
  }}
}

// ---- people

screen user_screen(user: User) {
  route "/users/:user"
  layout app
  <Title>{user.name}</Title>
  <Fill name=nav>
    <Link to={back} icon="arrow-left" label="Go Back" />
    {if user == actor {
      <Link to={profile_screen()} icon="pencil" label="Edit my profile" />
    }}
  </Fill>
  <Fill name=main>
    <section class={"panel" + (if user.status == banned { " banned" } else { "" })}>
      <Avatar large>{user}</Avatar>
      {if user.role == bot {
        {if user.status == active {
          <Button action={create_direct_room(set(user))} icon="messages" label={"Ping " + user.name} />
          <On ok go={room_screen(result)} />
        } else {
          <span>{user.name + " is no longer on this account"}</span>
        }}
      } else if user.status != deactivated {
        <h1 class="txt-large">{user.name}</h1>
        {if can_administer(actor, none) {
          <Link href={"mailto:" + user.email}>
            <span>{user.email}</span>
          </Link>
        }}
        <span>{user.bio}</span>
        {if user.status == active {
          <Button action={create_direct_room(set(user))} icon="messages" label={"Ping " + user.name} />
          <On ok go={room_screen(result)} />
          {if can_administer(actor, none) {
            <TransferLinkPanel u={user} />
          }}
        }}
        {if can_administer(actor, none) and user != actor {
          {if user.status == active {
            <Button action={ban_user(user)} icon="cancel" text={"Ban " + user.name} confirm="Are you sure you want to ban this user? This will log them out, delete their messages, and block their IP addresses." />
          } else {
            <Button action={unban_user(user)} icon="cancel" text="Remove ban" confirm="Are you sure you want to remove the ban on this user?" />
          }}
        }}
      } else {
        <h1 class="txt-large">{user.name}</h1>
        <span>{user.name + " is no longer on this account"}</span>
      }}
    </section>
  </Fill>
}

screen profile_screen {
  route "/users/me/profile"
  layout app
  <Title>{actor.name}</Title>
  <Fill name=nav>
    <div class="flex-item-justify-start">
      <Link to={back} icon="arrow-left" label="Go Back" />
    </div>
    <div class="flex-item-justify-end">
      <Button action={sign_out(push_endpoint: client.push_endpoint)} icon="logout" label="Log out" />
      <On ok go={home} />
    </div>
  </Fill>
  <Fill name=main>
    <section class="panel">
      <Widget call={pwa_install_instructions} />
      <div class="align-center center avatar__form gap">          // users/profiles/show: a camera button, and the avatar itself, each choosing a new one
        <Form action={update_profile} auto_submit class="txt-medium">
          <Field label_hidden name=avatar kind=file icon="camera" label="Upload avatar" accept="image/*" class="btn input--file" />
          <On ok stay flash={result} />
        </Form>
        <Form action={update_profile} auto_submit>
          <Field label_hidden name=avatar kind=file preview={actor} label="Avatar" accept="image/*" class="btn avatar input--file txt-xx-large" />
          <On ok stay flash={result} />
        </Form>
        {if actor.avatar != none {
          <Button action={delete_avatar()} icon="minus" label="Delete avatar" class="btn btn--negative txt-small avatar__delete-btn" />
        }}
      </div>
      <Form action={update_profile}>
        <Field name=name kind=text value={actor.name} placeholder="Enter your name" icon="person" required />
        <Field name=email kind=email value={actor.email} placeholder="Enter your email address" icon="email" />
        <Field name=password kind=password placeholder="Change password" icon="password" maxlength={72} />
        <Field rows={3} name=bio kind=textarea value={actor.bio} placeholder="A few words about yourself…" icon="bio" maxlength={200} />
        <Submit icon="check" label="Save changes" />
        <On ok stay flash={result} />
      </Form>
      <menu class="memberships">
        <List of={sidebar_rooms()} as=ms where={ms.room.type != direct}>
          <MembershipRow ms={ms} />
        </List>
        <Separator />
        <List of={sidebar_rooms()} as=ms where={ms.room.type == direct}>
          <MembershipRow ms={ms} />
        </List>
      </menu>
      <TransferLinkPanel u={actor} />
      <div class="center">                                         // a departure from Rails: tokens for AI agents acting for you
        <Link href="/_agents" label="AI agent access" class="btn txt-small" />
      </div>
    </section>
  </Fill>
}

component MembershipRow(ms: Membership) {                         // users/profiles/_membership
  <div class="flex align-center gap margin-none min-width membership-item">
    <Link to={room_screen(ms.room)} class="overflow-ellipsis fill-shade txt-primary txt-undecorated">
      <strong>{display_name(ms.room, actor)}</strong>
    </Link>
    <Separator />
    <div class="txt-small">
      <InvolvementToggle room={ms.room} />
    </div>
  </div>
}

component TransferLinkPanel(u: User) {
  <div class="flex flex-column gap">
    {if u != actor {
      <div class="flex align-center gap">
        <Icon>{"crown"}</Icon>
        <span>Share to get them back into their account</span>
      </div>
    }}
    <FieldDisplay readonly label={if u == actor { "Use this link to login automatically on another device" } else { "Share to get them back into their account" }}>{url_of(transfer_screen(transfer_link(u)))}</FieldDisplay>
    <div class="flex align-center gap">
      <Widget call={qr_link(url_of(transfer_screen(transfer_link(u))))} icon="qr-code" label="Show auto-login QR code" />
      <Widget call={copy_button(url_of(transfer_screen(transfer_link(u))))} icon="copy-paste" label="Copy auto-login link" />
      <Widget call={share_button(url_of(transfer_screen(transfer_link(u))), "Your sign-in link",
        "This is your own private sign-in URL, DO NOT SHARE IT. Use it to sign-in on another device or if you get locked out.")} icon="share" label="Share auto-login link" />
    </div>
  </div>
}

screen push_subscriptions_screen {
  route "/users/me/push_subscriptions"
  layout app
  <Fill name=main>
    <List of={push_subscriptions()} as=s>
      <div class="flex align-center gap">
        <span>{s.user_agent}</span>
        <Button action={send_test_notification(s)} label="Test" />
        <Button action={unsubscribe_push(s)} icon="minus" label="Remove" />
      </div>
    </List>
  </Fill>
}

// ---- account administration

screen account_screen {
  route "/account/edit"
  layout app
  <Title>Account settings</Title>
  <Fill name=nav>                                                               // accounts/edit.html.erb
    <div class="flex-item-justify-start">
      <Link to={room_screen(last_room_visited())} icon="arrow-left" label="Go Back" />
    </div>
    {if administrator(actor) {
      <div class="flex align-center gap flex-item-justify-end">
        <Link to={bots_screen()} icon="bot" label="Set up chat bots" />
        <Link to={custom_styles_screen()} icon="art" label="Custom styles" />
      </div>
    }}
  </Fill>
  <Fill name=main>
    <section class="panel txt-align-center flex flex-column gap">
      {if can_administer(actor, none) {
        <div class="align-center center avatar__form gap">
          <Form action={update_account} auto_submit class="txt--medium">
            <Field label_hidden name=logo kind=file icon="camera" label="Upload logo" accept="image/*" class="btn input--file" />
          </Form>
          <Form action={update_account} auto_submit>
            <Field label_hidden name=logo kind=file preview={theme.logo} label="Upload logo" accept="image/*" class="btn avatar input--file account-logo txt-xx-large" />
          </Form>
          {if Account.logo != none {
            <Button action={delete_logo()} icon="minus" label="Delete logo" class="btn btn--negative txt-small avatar__delete-btn" />
          }}
        </div>
        <Form action={update_account} class="flex flex-column gap" bare>
          <div class="flex align-center gap">
            <Field name=name kind=text value={Account.name} placeholder="Name this account" class="flex align-center gap flex-item-grow txt-large" />
            <Submit icon="check" label="Save changes" />
          </div>
          <On ok stay flash="✓" />
        </Form>
        <div class="margin-block-start pad-block pad-inline-double fill-shade border-radius">
          <Form action={update_account(restrict_room_creation: not Account.restrict_room_creation)} class="flex align-center gap center" bare>
            <div class="flex-item-grow flex align-center gap txt-align-start">
              <Icon>{"crown"}</Icon>
              <span>Must be admin to create new rooms</span>
            </div>
            <Switch value={Account.restrict_room_creation} auto_submit label="Must be admin to create new rooms" />
          </Form>
        </div>
      } else {
        <Image>{theme.logo}</Image>
        <h1 class="txt-large">{Account.name}</h1>
      }}
      <div class="fill-shade">
        <Invite />
        <Separator />
        <menu class="flex flex-column gap margin-none pad">
          <List of={account_users()} as=u where={u.role == administrator}>
            <AccountUserRow u={u} />
          </List>
          <Separator />
          <List of={account_users()} as=u where={u.role != administrator}>
            <AccountUserRow u={u} />
          </List>
        </menu>
      </div>
    </section>
  </Fill>
  <Fill name=footer>
    <span>{"Campfire™ version " + app.version}</span>
  </Fill>
}

component AccountUserRow(u: User) {
  <div class={"flex align-center gap" + (if u.status == banned { " banned" } else { "" })}>
    <div class="avatar flex-item-no-shrink">
      <Link to={user_screen(u)} class="btn avatar" title={u.name}>
        <Avatar bare>{u}</Avatar>
      </Link>
    </div>
    <strong>{u.name}</strong>
    <Separator />
    {if can_administer(actor, none) and u.status == active {
      {if u.role != bot {
        <Form action={change_role(u, if u.role == administrator { "member" } else { "administrator" })} auto_submit disabled={u == actor}>
          <Switch icon="crown" value={u.role == administrator} label={"Role: " + (if u.role == administrator { "Administrator" } else { "Member" })} />
        </Form>
      }}
      {if u != actor {
        <Button action={deactivate_user(u)} icon="minus" label={"Delete " + u.name} class="btn btn--negative" confirm="Are you sure you want to permanently remove this person from the account? This can’t be undone." />
      }}
    }}
    {if u == actor {
      <Link to={profile_screen()} icon="pencil" label="My settings" />
    }}
  </div>
}

screen custom_styles_screen {
  route "/account/custom_styles/edit"
  layout app
  require can_administer(actor, none) else forbidden
  <Title>Custom styles</Title>
  <Fill name=nav>
    <Link to={account_screen()} icon="arrow-left" label="Go Back" />
  </Fill>
  <Fill name=main>
    <section class="panel panel--wide">
      <h1 class="txt-large">Custom CSS</h1>
      <span>Add custom CSS styles.</span>
      <Icon>{"alert"}</Icon>
      <span>Use Caution: you could break things.</span>
      <Form action={update_custom_styles} submit_on="ctrl+enter">
        <Field name=custom_styles kind=code value={Account.custom_styles} placeholder="Add CSS styles…" rows={16} />
        <Submit icon="check" label="Save changes" />
        <On ok stay flash="✓" />
      </Form>
    </section>
  </Fill>
}

screen bots_screen {
  route "/account/bots"
  layout app
  require can_administer(actor, none) else forbidden
  <Title>Chat bots</Title>
  <Fill name=nav>
    <Link to={account_screen()} icon="arrow-left" label="Go Back" />
  </Fill>
  <Fill name=main>
    <section class="panel panel--wide">
      <h1 class="txt-large">Chat bots</h1>
      <span>With Chat bots, other sites and services can post updates directly to Campfire.</span>
      <Link to={new_bot_screen()} icon="add" label="Add a chat bot" />
      <List of={bots()} as=b>
        <div class="flex flex-column gap">
          <div class="flex align-center gap">
            <Avatar>{b}</Avatar>
            <strong>{b.name}</strong>
            <Link to={edit_bot_screen(b)} icon="pencil" label={"Edit " + b.name} />
          </div>
          {for each r in list(.room for Membership where .user == b and .room.type != direct order by lower(.room.name)) {
            <fieldset><legend><strong>{display_name(r, actor)}</strong></legend>
              {let post = "curl -d 'Hello!' " + url_of(bot_messages(r, bot_key(b)))}
              {let upload = "curl -F \"attachment=@/path/to/file\" " + url_of(bot_messages(r, bot_key(b)))}
              <div class="flex align-center gap">
                <Icon>{"messages-outlined"}</Icon>
                <FieldDisplay readonly label="Message command">{post}</FieldDisplay>
                <Widget call={copy_button(post)} icon="copy-paste" label="Copy message command" />
              </div>
              <div class="flex align-center gap">
                <Icon>{"attachment"}</Icon>
                <FieldDisplay readonly label="Attachment command">{upload}</FieldDisplay>
                <Widget call={copy_button(upload)} icon="copy-paste" label="Copy attachment command" />
              </div>
            </fieldset>
          }}
        </div>
      </List>
    </section>
  </Fill>
}

screen new_bot_screen {
  route "/account/bots/new"
  layout app
  require can_administer(actor, none) else forbidden
  <Fill name=main>
    <BotForm bot={none} />
  </Fill>
}

screen edit_bot_screen(b: User) {
  route "/account/bots/:b/edit"
  layout app
  require can_administer(actor, none) and b.role == bot and b.status == active else not_found
  <Fill name=main>
    <BotForm bot={b} />
    <div class="flex align-center gap">
      <span>{bot_key(b)}</span>
      <Button action={reset_bot_key(b)} icon="refresh" label="Reset key" />
      <Button action={delete_bot(b)} icon="trash" label="Delete bot" />
      <On ok go={bots_screen()} />
    </div>
  </Fill>
}

component BotForm(bot: User?) {
  {if bot == none {
    <Form action={create_bot}>
      <Field label_hidden name=avatar kind=file label="Upload bot avatar" accept="image/*" />
      <Field name=name kind=text placeholder="Name the bot" icon="bot" required />
      <Field name=webhook_url kind=url placeholder="Webhook URL" icon="web" />
      <Submit icon="check" label="Save" />
      <On ok go={bots_screen()} />
    </Form>
  } else {
    <Form action={update_bot(bot)}>
      <Field label_hidden name=avatar kind=file preview={bot.avatar} label="Upload bot avatar" accept="image/*" />
      <Field name=name kind=text value={bot.name} placeholder="Name the bot" icon="bot" required />
      <Field name=webhook_url kind=url value={webhook_of(bot)} placeholder="Webhook URL" icon="web" />
      <Submit icon="check" label="Save" />
      <On ok go={bots_screen()} />
    </Form>
  }}
}
fn webhook_of(b: User): Url? = if exists(Webhook where .user == b) { the(Webhook where .user == b).url } else { none }

// ---- runtime-served assets: avatars (initials or default bot avatar), logos, the QR
// codes, the web app manifest and service worker. They have no logic beyond the widgets
// and the theme, so the runtime provides them (users/avatars_controller.rb,
// accounts/logos_controller.rb, qr_code_controller.rb, pwa_controller.rb).

// ======================================================================== invariants
// Facts every action and workflow step keeps, proven at each build (lang/invariants.ts)

fn has_members(r: Room): Bool = exists(Membership where .room == r)
invariant bots_have_tokens: all(.bot_token != none for User where .role == bot)
invariant direct_rooms_have_members: all(has_members(it) for Room where .type == direct)
invariant sessions_of_active: all(.user.status == active for Session where true)
invariant admin_exists: not exists(Account where true) or exists(User where .role == administrator and .status == active)
invariant deactivated_only_in_direct_rooms: all(.user.status != deactivated or .room.type == direct for Membership where true)
