// The HTML elements a spec writes in lowercase, as plain HTML: the HTML standard's elements of a
// page's body, with the attributes each takes (besides the global ones, and data-* and aria-*).
// The checker reads them (an element or attribute HTML doesn't have is a slip, likely); a tag
// with a hyphen is a web component, and isn't checked. An element with a Children parameter has
// content; one without is void (<br>, <img …>), written without a closing tag. Flag: an
// attribute written bare (<input required>). A page's head, and its scripts, are the runtime's.
// Handlers (onclick=…) and <script> are refused by the checker; <slot> is the layout's <Slot>.

// The attributes every HTML element takes.
native common html(
  class: Value, id: Value, title: Value, lang: Value, dir: Value, hidden: Flag, tabindex: Value,
  role: Value, accesskey: Value, autofocus: Flag, contenteditable: Value, draggable: Value,
  inputmode: Value, spellcheck: Value, translate: Value, enterkeyhint: Value, popover: Value,
  inert: Flag, is: Value, itemprop: Value, itemscope: Flag, itemtype: Value, itemid: Value,
  itemref: Value, nonce: Value, part: Value, autocapitalize: Value, style: Value,
)

